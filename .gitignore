*.db-journal
*.db-wal
*.db-shm
.run/
*.log
data/

# ── 环境变量 ──────────────────────────────────────────────────────────────
#真实 .env.production / .env.*.local 不入库；
# 各档位的共享配置（.env.development / .env.test / *.example）是入库的。
*.local
.env
.env.production

