# Web server
# 0.0.0.0 allows access through LAN IPs and domains pointed at this machine.
# Use 127.0.0.1 if you only need local access.
HOST=0.0.0.0
PORT=4310

# Agent workspace (all requested working directories must stay inside this root)
# AGENT_WORKSPACE_ROOT=/Users/you/github/project

# Highly recommended when HOST=0.0.0.0. When set, API requests need
# "Authorization: Bearer <token>".
# AGENT_ACCESS_TOKEN=

# Allow the danger-full-access sandbox in the UI. Disabled by default.
# AGENT_ALLOW_DANGER_FULL_ACCESS=0

# Abort a turn when Codex emits no events for this many milliseconds.
# 0 disables the watchdog. Default: 600000 (10 minutes).
# AGENT_TURN_IDLE_TIMEOUT_MS=600000

# Defaults for new sessions. Leave the model empty to use your Codex CLI config.
# AGENT_DEFAULT_MODEL=
# CODEX_PATH=/usr/local/bin/codex

# Only needed when you are not already signed in through the Codex CLI.
# CODEX_API_KEY=
# Custom Responses API endpoint. Requests are sent over HTTPS only (WebSocket is
# disabled), so endpoints that implement only the HTTP /responses route work.
# Set AGENT_DEFAULT_MODEL (or the model field in the UI) to a model the endpoint
# actually serves; leaving it empty falls back to Codex's built-in default.
# CODEX_BASE_URL=
