# ─────────────────────────────────────────────────────────────────────────────
# 开发环境（NODE_ENV=development）
#
# 本文件**入库**：只放团队共享的非敏感配置。
# 个人私有覆盖写 .env.development.local（gitignore），优先级更高。
# 容器 / CI 注入的真实环境变量优先级**最高**，文件只补空缺。
#
# 变量的事实源是 src/config/env.validation.ts 的 ENV_SPECS，本文件若与其
# 不一致以代码为准。完整可选变量清单见 .env.example。
#
# 加载档位（src/config/env-files.ts）：
#   .env.development.local > .env.development > .env.local > .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# 端口：start.sh 未显式指定时用这里的值
# 刻意避开 3000/3001/5173 这类常被其它前端/网关项目占用的端口
PORT=4100
# 只绑回环，不把调试端口暴露到局域网（手机同网段调试走 CORS_ALLOW_PRIVATE_LAN）
HOST=127.0.0.1
API_PREFIX=api/v1

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 开发演示库。test / production 环境各自指向不同的库文件。
DATABASE_URL=file:./dev.db

# ── 运行期目录（相对路径相对 backend/）────────────────────────────────────────
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# ── CORS ────────────────────────────────────────────────────────────────────
# 留空走默认开发白名单（localhost/127.0.0.1/[::1] × 5100）
CORS_ORIGINS=
# 放开私有网段供手机同WiFi 调试：需要时置1
CORS_ALLOW_PRIVATE_LAN=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 留空用内置开发默认密钥；生产环境不设置会直接启动失败
JWT_SECRET=
# 开发态长TTL，省得反复登录
JWT_TTL=7d

# ── 后台管理员预设（仅 development/test）──────────────────────────────────
# start.sh 会自动执行 seed:admin；已有同名账号时不重置密码。
# 如需个人覆盖，写入 .env.development.local 或使用同名环境变量。
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=123456789

# ── 前端站点基址（邮件里的重置链接用）──────────────────────────────────────
# 必须填用户浏览器能打开的地址；改域名/反代后同步修改
WEB_BASE_URL=http://localhost:5100

# ── 邮件通道 ────────────────────────────────────────────────────────────────
# console = 不发网络请求，正文写入 logs/outbox/email-*.log（开发/测试默认）
# http    = POST 到 EMAIL_API_URL，需同时给 EMAIL_API_KEY
# aliyun  = 直调阿里云 SingleSendMail（需下方 ALIYUN_* 凭据）
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@huojue.local

# ── 短信通道 ────────────────────────────────────────────────────────────────
# console = 验证码写入 logs/outbox/sms-*.log（开发打印验证码，生产不打印）
# http    = POST 到 SMS_API_URL，需同时给 SMS_API_KEY
# aliyun  = 直调阿里云 SendSms（需下方 ALIYUN_* 凭据）
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=货觉AI
SMS_TEMPLATE=

# ── 阿里云短信 / 邮件（SMS_PROVIDER=aliyun 或 EMAIL_PROVIDER=aliyun 时必填）──
# 开发档一律留空（走 console）；需要联调时本地填临时 AccessKey，不要提交
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_DM_ADDRESS_TYPE=1

# ── 支付通道 ────────────────────────────────────────────────────────────────
# sandbox 不产生真实资金流转；alipay / wechat 需补齐对应凭据。
# 凭据缺失时发起支付返回 503，不会静默降级为沙箱。
PAYMENT_PROVIDER=sandbox
PAYMENT_NOTIFY_BASE=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=log
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_MB=20
LOG_MAX_FILES_PER_DAY=5
LOG_CONSOLE=1
LOG_ERROR_FILE=1

# ── 图像生成网关 ─────────────────────────────────────────────────────────────
# 不配置则 15 项能力全部走本地 Jimp（7 real + 8 mock）
GATEWAY_BASE_URL=
GATEWAY_TOKEN=
GATEWAY_MODEL=
GATEWAY_ENABLED=
GATEWAY_TIMEOUT_MS=120000
GATEWAY_POLL_MS=2000
GATEWAY_MAX_POLLS=60
ASSET_PUBLIC_BASE=

# ── 存储后端 ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=huojue
# 开发态保持公开与限流开启：限流只在登录/短信/生成/上传上生效，正常操作感知不到
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
ASSET_SIGNING_SECRET=
ERROR_WEBHOOK_URL=

RATE_LIMIT_AUTH_PER_MIN=10
