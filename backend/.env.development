# ─────────────────────────────────────────────────────────────────────────────
# 开发环境（NODE_ENV=development）
#
# 本文件**入库**：只放团队共享的非敏感配置。
# 个人私有覆盖写 .env.development.local（gitignore），优先级更高。
# 容器 / CI 注入的真实环境变量优先级**最高**，文件只补空缺。
#
# 变量的事实源是 src/config/env.validation.ts 的 ENV_SPECS，本文件若与其
# 不一致以代码为准。完整可选变量清单见 .env.example。
#
# 加载档位（src/config/env-files.ts）：
#   .env.development.local > .env.development > .env.local > .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# 端口：start.sh 未显式指定时用这里的值
PORT=3001
# 只绑回环，不把调试端口暴露到局域网（手机同网段调试走 CORS_ALLOW_PRIVATE_LAN）
HOST=127.0.0.1
API_PREFIX=api/v1

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 开发演示库。test / production 环境各自指向不同的库文件。
DATABASE_URL=file:./dev.db

# ── 运行期目录（相对路径相对 backend/）────────────────────────────────────────
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# ── CORS ────────────────────────────────────────────────────────────────────
# 留空走默认开发白名单（localhost/127.0.0.1/[::1] × 5173、4173）
CORS_ORIGINS=
# 放开私有网段供手机同WiFi 调试：需要时置1
CORS_ALLOW_PRIVATE_LAN=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 留空用内置开发默认密钥；生产环境不设置会直接启动失败
JWT_SECRET=
# 开发态长TTL，省得反复登录
JWT_TTL=7d

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=log
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_MB=20
LOG_MAX_FILES_PER_DAY=5
LOG_CONSOLE=1
LOG_ERROR_FILE=1

# ── 图像生成网关 ─────────────────────────────────────────────────────────────
# 不配置则 15 项能力全部走本地 Jimp（7 real + 8 mock）
GATEWAY_BASE_URL=
GATEWAY_TOKEN=
GATEWAY_MODEL=
GATEWAY_ENABLED=
GATEWAY_TIMEOUT_MS=120000
GATEWAY_POLL_MS=2000
GATEWAY_MAX_POLLS=60
ASSET_PUBLIC_BASE=

# ── 存储后端 ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=huojue