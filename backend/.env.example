# ─────────────────────────────────────────────────────────────────────────────
# 后端环境变量总清单（**不是**要复制的模板）
#
# 三环境体系（2026-10-20 起）
# ---------------------------------------------------------------------------
#   .env.development           开发 —— 已入库，直接生效，通常无需改
#   .env.test                  测试 —— 已入库，直接生效，通常无需改
#   .env.production.example    生产样例 —— 复制为 .env.production 后填写（含凭据，不入库）
#   .env.{env}.local           个人私有覆盖 —— 不入库，优先级最高
#
# 档位选择逻辑在 src/config/env-files.ts。test / production **不回落 .env**，
# 刻意断开，避免共享 .env 里的 DATABASE_URL 把测试/生产连到开发库。
#
# 加载优先级（数组靠前优先）：
#   development: .env.development.local > .env.development > .env.local > .env
#   test       : .env.test.local        > .env.test
#   production : .env.production.local  > .env.production
#
# 外部环境变量（容器 / CI 注入）优先级最高，文件只补空缺。
#
# 三条规则：
#   1. 变量的事实源是 src/config/env.validation.ts 的 ENV_SPECS，本文件若与它
#      不一致，以代码为准并回来修本文件
#   2. 全部变量都有默认值 —— 不写任何一行也能启动，本文件是「可选项清单」
#   3. 带凭据的项目（TOKEN / SECRET / ACCESS_KEY）留空即视为未配置，走回落分支
#
# 环境矩阵与切换方式详见 docs/environments.md。
# ─────────────────────────────────────────────────────────────────────────────

# ── 应用 ────────────────────────────────────────────────────────────────────
# 默认值见 env.validation.ts；开发档 4100 / 测试档 4200
PORT=4100
# 监听地址：开发只绑回环；容器内必须 0.0.0.0
HOST=127.0.0.1
API_PREFIX=api/v1
# development | production | test —— production 会强制要求 JWT_SECRET 且
# 禁止 DATABASE_URL 停留在开发库默认值
NODE_ENV=development

# ── 数据库 ────────────────────────────────────────────────────────────────────
# SQLite 文件路径，形如 file:./dev.db，相对路径相对 backend/。
# 三环境必须各指各的库，否则「测试跑挂开发数据」无从排查。
DATABASE_URL=file:./dev.db

# ── 运行期目录（相对路径相对 backend/）────────────────────────────────────────
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# ── CORS ────────────────────────────────────────────────────────────────────
# 逗号分隔的显式白名单，给定即覆盖默认规则（生产必须给，否则只放行本机端口）
CORS_ORIGINS=
# 额外放行私有网段任意端口（10. / 172.16-31. / 192.168.），供手机同 WiFi 调试
CORS_ALLOW_PRIVATE_LAN=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 不设置则用内置开发默认密钥（仅开发可用）；生产环境不设置会直接启动失败
JWT_SECRET=
# 演示环境放宽到 7d，生产应恢复短 TTL + refresh
JWT_TTL=7d

# 前端站点基址：邮件里的「重置密码」链接用它拼绝对地址
WEB_BASE_URL=http://localhost:5100

# ── 通用 OAuth（第三方登录）──────────────────────────────────────────────
# 内置 google / github，另有 generic 可接任意标准 OAuth2/OIDC provider。
# 凭据齐全即启用；配置 OAUTH_ENABLED=google,github 可只放行部分 provider。
# 回调地址：https://your-domain/api/v1/auth/oauth/<provider>/callback
OAUTH_ENABLED=
OAUTH_CALLBACK_BASE=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=

OAUTH_GENERIC_NAME=
OAUTH_GENERIC_CLIENT_ID=
OAUTH_GENERIC_CLIENT_SECRET=
OAUTH_GENERIC_REDIRECT_URI=
OAUTH_GENERIC_AUTHORIZATION_ENDPOINT=
OAUTH_GENERIC_TOKEN_ENDPOINT=
OAUTH_GENERIC_USERINFO_ENDPOINT=
OAUTH_GENERIC_SCOPES=

# ── 外部消息通道（邮件 / 短信）──────────────────────────────────────────────
# console = 不发网络请求，正文写入 logs/outbox/（开发/测试默认）
# http    = POST 到对应 API_URL，需同时给 API_KEY
# aliyun  = 直调阿里云 SendSms / SingleSendMail（RPC 签名，无需 SDK）
# 填了真实通道却缺凭据会回落 console 并打启动 WARN（delivers=false）
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@huojue.local

SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=货觉AI
SMS_TEMPLATE=

# ── 阿里云短信 / 邮件（EMAIL_PROVIDER=aliyun 或 SMS_PROVIDER=aliyun 时必填）──
# ALIYUN_SMS_SIGN_NAME      = 控制台已审核通过的签名
# ALIYUN_SMS_TEMPLATE_CODE  = 模板号 SMS_xxxxxxx（模板变量名必须是 code）
# ALIYUN_SMS_REGION         = 地域 id；留空或 cn-hangzhou 走中心域名
# ALIYUN_DM_ACCOUNT_NAME    = 控制台已配置的发信地址
# ALIYUN_DM_ADDRESS_TYPE    = 1 随机账号 / 0 批量发信
# AccessKey 只用于签名，不落日志、不入库；生产请用最小权限子账号
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_DM_ADDRESS_TYPE=1

# ── 支付通道（B3）──────────────────────────────────────────────────────────
# sandbox = 站内模拟支付（开发默认，不产生真实资金流转）
# alipay  = 支付宝网页支付（RSA2）; wechat = 微信支付 API v3（Native 扫码）
# ⚠ 凭据缺失时发起支付返回 503，**不会**静默降级为沙箱
# 渠道配置存库（后台「支付充值 → 支付渠道」维护），env 只在首次启动导入为 v1
PAYMENT_SECRET_KEY=
# 渠道异步通知基址（必须公网可达）；留空用 HOST:PORT
PAYMENT_NOTIFY_BASE=

# 支付宝（多行 PEM 用 \n 连接成一行即可，代码会还原）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# 微信支付 API v3
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
# 回调验签用平台证书公钥（不是商户私钥）
WECHAT_PLATFORM_PUBLIC_KEY=


# ── 日志落盘 ────────────────────────────────────────────────────────────────
# error | warn | log | debug | verbose
LOG_LEVEL=log
# 相对路径相对 backend/；也可给绝对路径
LOG_DIR=logs
# 过期日志清理天数
LOG_RETENTION_DAYS=14
# 单文件体积上限（MB），超限按 .1/.2 切片
LOG_MAX_FILE_MB=20
# 单日分片数上限
LOG_MAX_FILES_PER_DAY=5
# 是否同时输出到控制台 —— 关掉后 start.sh 的 .run/backend.log 将不再有内容
LOG_CONSOLE=1
# 是否额外产出 app-<日期>.error.log（只收 error/fatal，便于告警扫描）
LOG_ERROR_FILE=1

# ── 素材对外基址 ────────────────────────────────────────────────────────────
# 生成通道不再走环境变量：渠道 / 渠道模型 / 前台模型全部在后台配置
# （渠道工作台 → 前台模型 → 用户分组），详见 docs/model-architecture.md。
#
# 参考图回传基址，上游需能拉取；留空则取 http://localhost:$PORT
ASSET_PUBLIC_BASE=

# ── 存储后端 ────────────────────────────────────────────────────────────────
# local | oss | minio
STORAGE_BACKEND=local

# 阿里云 OSS：三项齐全才启用
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# MinIO：两项齐全才启用
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=huojue
# ── 安全与可观测（B5）────────────────────────────────────────────────────
# 限流总开关。默认开启；本地压测可临时关，生产禁止。
RATE_LIMIT_ENABLED=true
# 是否信任反向代理的 X-Forwarded-For。只有确实部署在 Nginx/LB 之后才设为 true，
# 否则任何人伪造该头即可绕开全部按 IP 的限流。
RATE_LIMIT_TRUST_PROXY=false
# 素材签名密钥。留空 = /uploads 公开可访问（默认）；设置后要求 HMAC 签名。
# 生成方式：openssl rand -base64 32（生产要求 ≥ 32 字符）
ASSET_SIGNING_SECRET=
# 未处理异常（5xx）外发告警的 webhook。留空 = 只落盘，不发外部请求。
ERROR_WEBHOOK_URL=

# 登录/注册/短信登录的每分钟上限（默认 10）。自动化测试可调高；短信与找回密码不受此影响
RATE_LIMIT_AUTH_PER_MIN=10
# 【仅测试档】限流计数重置入口的令牌（POST /api/v1/test/rate-limit/reset）。
# NODE_ENV != test 时该路由返回 404；生产/开发档留空即可。
RATE_LIMIT_RESET_TOKEN=

# ── 渠道与模型子系统（移植自 open-ai-canvas）──────────────────────────────
# 渠道凭证加密密钥：base64 编码的 32 字节（openssl rand -base64 32）。
# 生产必须显式配置；留空时开发态自动生成到 ../data/.model-secret-key。
# 更换密钥等于所有已保存的上游凭证作废，须重新录入。
MODEL_SECRET_KEY=
# 插件包目录（相对 backend/）。启动期扫描 <id>/manifest.json 并注册协议。
# MODEL_PLUGIN_DIR 是随代码入库的内置包（只读，不可卸载）；后台上传的包装到
# MODEL_PLUGIN_INSTALL_DIR，两者分开扫描，内置包 id 优先。
MODEL_PLUGIN_DIR=plugins
MODEL_PLUGIN_INSTALL_DIR=plugins-installed
# 服务商目录（远端 JSON）。留空 = 后台目录为空态，不内置任何厂商条目
MODEL_PROVIDER_CATALOG_URL=
# 单账号并发生成任务上限
MODEL_ACTIVE_TASK_LIMIT=2
# 上游请求 / 产物下载超时（毫秒）
MODEL_HTTP_TIMEOUT_MS=120000
MODEL_MEDIA_TIMEOUT_MS=180000
# worker 轮询间隔与单次任务租约（毫秒）
MODEL_WORKER_INTERVAL_MS=1000
MODEL_LEASE_MS=120000
# 渠道并发槽等槽上限（毫秒）：超时即按「渠道忙」切线 / 429，不无限排队
MODEL_SLOT_WAIT_MS=60000
# SSRF 逃生开关：仅部署者使用。自定义渠道不受此开关影响，必须逐个点名主机。
MODEL_ALLOW_PRIVATE_UPSTREAMS=false
# 允许访问私网的可信上游主机名，逗号分隔（如内网网关）
MODEL_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# 代理中转总开关（false 时系统渠道与自定义渠道中转一律 503）
MODEL_PROXY_ENABLED=true
# 系统渠道中转：请求体 / 响应体上限（MB）与上游超时（毫秒）
MODEL_PROXY_SYSTEM_REQUEST_MB=32
MODEL_PROXY_SYSTEM_RESPONSE_MB=64
MODEL_PROXY_SYSTEM_TIMEOUT_MS=600000
# 自定义渠道中转：请求体 / 响应体上限（MB）与上游超时（毫秒）
MODEL_PROXY_CUSTOM_REQUEST_MB=32
MODEL_PROXY_CUSTOM_RESPONSE_MB=64
MODEL_PROXY_CUSTOM_TIMEOUT_MS=600000
# 单用户自定义中转并发（0 = 不限）
MODEL_PROXY_CUSTOM_CONCURRENCY=2
# 中转限流（次 / 分钟，按用户）。由限流守卫在请求期读取，不经过配置树。
MODEL_PROXY_SYSTEM_RATE_LIMIT=120
MODEL_PROXY_CUSTOM_RATE_LIMIT=60
# 代理账单兜底清扫：reserved 超时自动退款、running 超时转人工核对
MODEL_BILLING_SWEEP_ENABLED=true
