# ─────────────────────────────────────────────────────────────────────────────
# 生产环境（NODE_ENV=production）—— 样例文件，**请复制为 .env.production 后填写**
#
#   cp .env.production.example .env.production
#
# ⚠ .env.production 含凭据，已被 backend/.gitignore 忽略，**绝不入库**。
#   本样例入库的唯一原因是让部署者知道「有哪些变量、必须配哪些」。
#
# 启动门禁（src/config/env.validation.ts 里validateEnv 的硬失败项）：
#   1. JWT_SECRET 未设置            → 启动失败
#   2. DATABASE_URL 仍为开发默认值   → 启动失败（防止线上污染 dev.db）
#   以上两条不是建议，是拒绝启动。想绕过请改代码，不要改门禁。
#
# 单机生产编排（docker-compose.production.yml）默认读取本文件；
# 也可用 BACKEND_ENV_FILE=/path/to/production.env 指向受控的密钥文件。
# 文件权限至少 chmod 600，且绝不能提交到 Git。
#
# 加载档位： .env.production.local > .env.production
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── 应用 ────────────────────────────────────────────────────────────────────
# 容器内必须 0.0.0.0：只绑 127.0.0.1 的话容器外完全连不上
HOST=0.0.0.0
# 生产端口由部署决定。docker-compose.production.yml 会覆盖为容器内 4100，
# 且不把该端口映射到宿主机；裸机运行时才使用这里的值。
PORT=4100
API_PREFIX=api/v1

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 生产库**必须**与开发库不同文件。下面两种形态都合法：
#   ① 容器内路径 + 具名卷（推荐，compose 已配好 huojue-data 卷）
DATABASE_URL=file:./data/prod.db
#   ② 宿主机绝对路径（裸机部署时用）
# DATABASE_URL=file:/var/lib/huojue/prod.db

# ── 运行期目录（必须是绝对路径或落在已挂载的卷里）────────────────────────────
# ⚠ 相对路径在容器里意味着数据在容器可写层 —— 重建镜像即丢全部上传图。
UPLOAD_DIR=/app/data/uploads
BACKUP_DIR=/app/data/backups

# ── CORS ────────────────────────────────────────────────────────────────────
# 生产**必须**显式给白名单：留空会回落到「只放行本机 5100」，
# 结果是线上页面的每一个请求都被浏览器拦掉
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# 私有网段放行生产一律关闭
CORS_ALLOW_PRIVATE_LAN=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
#必填：生成方式 → node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 生产不建议沿用演示的 7d
JWT_TTL=2h

# ── 前端站点基址（邮件里的重置链接用）──────────────────────────────────────
# 生产必须填真实域名（https），否则重置链接会把用户带到 localhost
WEB_BASE_URL=https://example.com

# ── 通用 OAuth（第三方登录，可选）──────────────────────────────────────────
# 回调示例：https://example.com/api/v1/auth/oauth/google/callback
# OAUTH_ENABLED 留空 = 凭据齐全的 provider 自动启用；填 google,github 则只放行列出的。
OAUTH_ENABLED=
OAUTH_CALLBACK_BASE=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_GOOGLE_AUTHORIZATION_ENDPOINT=
OAUTH_GOOGLE_TOKEN_ENDPOINT=
OAUTH_GOOGLE_USERINFO_ENDPOINT=
OAUTH_GOOGLE_SCOPES=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=
OAUTH_GITHUB_AUTHORIZATION_ENDPOINT=
OAUTH_GITHUB_TOKEN_ENDPOINT=
OAUTH_GITHUB_SCOPES=
OAUTH_GENERIC_NAME=
OAUTH_GENERIC_CLIENT_ID=
OAUTH_GENERIC_CLIENT_SECRET=
OAUTH_GENERIC_REDIRECT_URI=
OAUTH_GENERIC_AUTHORIZATION_ENDPOINT=
OAUTH_GENERIC_TOKEN_ENDPOINT=
OAUTH_GENERIC_USERINFO_ENDPOINT=
OAUTH_GENERIC_SCOPES=

# ── 邮件通道 ────────────────────────────────────────────────────────────────
# 生产必须为 http 或 aliyun：console 只把正文写进 logs/outbox，用户永远收不到信
# aliyun = 阿里云邮件推送（SingleSendMail），需下方 ALIYUN_* 凭据
EMAIL_PROVIDER=http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# ── 短信通道 ────────────────────────────────────────────────────────────────
# 生产必须为 http 或 aliyun：console 在 NODE_ENV=production 下不打印验证码也不落盘
# aliyun = 阿里云短信（SendSms），需下方 ALIYUN_* 凭据
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=货觉AI
SMS_TEMPLATE=

# ── 阿里云短信 / 邮件 ───────────────────────────────────────────────────────
# 二选一配置即可（或与上面的 http 通道并存，按 PROVIDER 决定用哪个）
# ALIYUN_ACCESS_KEY_ID / SECRET 建议用只授权 Dysms + Dm 的子账号，勿用主账号
# 凭据只从环境变量读，不落库、不进审计、后台页面无写端点
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_DM_ADDRESS_TYPE=1

# ── 支付通道 ────────────────────────────────────────────────────────────────
# ⚠ 生产环境必须配置真实通道：sandbox 在生产不接收回调，且不会产生资金流转。
# 凭据缺失时发起支付返回 503，不会静默降级为沙箱。
# 渠道配置存库（后台「支付充值 → 支付渠道」维护），env 只在首次启动导入为 v1
PAYMENT_SECRET_KEY=
# 渠道异步通知基址（必须公网可达），例如 https://api.example.com
PAYMENT_NOTIFY_BASE=
ALIPAY_APP_ID=
# 多行 PEM 用 \n 串联成一行
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 留空 = 正式网关；沙箱网关填 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# 生产 https://api-m.paypal.com；沙箱 https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# 留空使用 https://api.stripe.com
STRIPE_API_BASE=
# 易支付（epay.jylt.cc）：微信 type=1，支付宝 type=2
EPAY_API_BASE=https://epay.jylt.cc
EPAY_MCH_ID=
EPAY_KEY=
EPAY_TYPE=2
# ZPay（zpayz.cn）：支付宝 type=alipay，微信 type=wxpay
ZPAY_API_BASE=https://zpayz.cn
ZPAY_PID=
ZPAY_KEY=
ZPAY_TYPE=alipay
# 支付渠道 ID，可选，多个用英文逗号隔开；留空由渠道随机选择
ZPAY_CID=

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=log
LOG_DIR=/app/data/logs
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_MB=50
LOG_MAX_FILES_PER_DAY=10
LOG_CONSOLE=1
LOG_ERROR_FILE=1

# ── 素材对外基址 ─────────────────────────────────────────────────────────────
# 生成通道不再走环境变量：渠道 / 渠道模型 / 前台模型全部在后台配置
# （渠道工作台 → 前台模型 → 用户分组）。没有可用线路时能力不可用，
# 任务会失败并退款，不会交付本地合成或占位图。
#
# 参考图回传基址：上游必须能访问到本服务的 /uploads/*
# 留空则取 http://localhost:$PORT —— 容器内这个地址指向自己，上游多半连不上
ASSET_PUBLIC_BASE=https://api.your-domain.com

# ── 存储后端 ─────────────────────────────────────────────────────────────────
# local | oss | minio。生产建议 oss/minio（上传图不该跟容器同生共死）
STORAGE_BACKEND=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=huojue
# 生产：限流必须开启；位于反向代理之后时把 TRUST_PROXY 设为 true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
# 必填且 ≥32 字符（openssl rand -base64 32），否则 /uploads 全公开
ASSET_SIGNING_SECRET=
# 本地缩略图开关：false=关闭（?w= 请求直接返回原图），true=开启
ASSET_THUMBNAIL_ENABLED=false
ERROR_WEBHOOK_URL=

RATE_LIMIT_AUTH_PER_MIN=10

# ── 渠道与模型子系统 ──
# 生产必填：渠道凭证加密密钥（base64 的 32 字节，openssl rand -base64 32）。
# 留空会退回自动生成的文件密钥，容器重建后丢失即全部上游凭证不可解密。
MODEL_SECRET_KEY=
MODEL_PLUGIN_DIR=plugins
MODEL_PLUGIN_INSTALL_DIR=plugins-installed
# 服务商目录（远端 JSON）。留空 = 后台目录为空态，不内置任何厂商条目
MODEL_PROVIDER_CATALOG_URL=
MODEL_ACTIVE_TASK_LIMIT=64
MODEL_HTTP_TIMEOUT_MS=120000
MODEL_MEDIA_TIMEOUT_MS=180000
MODEL_WORKER_INTERVAL_MS=1000
MODEL_LEASE_MS=120000
# 渠道并发槽等槽上限（毫秒）：超时即按「渠道忙」切线 / 429，不无限排队
MODEL_SLOT_WAIT_MS=60000
# 冷却、并发槽与目录版本都是进程内存实现：多实例部署时每台各自判定，上游配额按实例数放大
# 默认关闭。确需访问内网网关时，优先用 MODEL_ALLOWED_PRIVATE_UPSTREAM_HOSTS 点名主机
MODEL_ALLOW_PRIVATE_UPSTREAMS=false
MODEL_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# 代理中转：上限单位 MB。逐项调大前先确认反代（Nginx client_max_body_size）
# 与容器内存；响应体整段留在内存里，上限×并发就是峰值占用。
MODEL_PROXY_ENABLED=true
MODEL_PROXY_SYSTEM_REQUEST_MB=32
MODEL_PROXY_SYSTEM_RESPONSE_MB=64
MODEL_PROXY_SYSTEM_TIMEOUT_MS=600000
MODEL_PROXY_CUSTOM_REQUEST_MB=32
MODEL_PROXY_CUSTOM_RESPONSE_MB=64
MODEL_PROXY_CUSTOM_TIMEOUT_MS=600000
MODEL_PROXY_CUSTOM_CONCURRENCY=2
MODEL_PROXY_SYSTEM_RATE_LIMIT=120
MODEL_PROXY_CUSTOM_RATE_LIMIT=60
# 代理账单兜底清扫：reserved 超时自动退款、running 超时转人工核对
MODEL_BILLING_SWEEP_ENABLED=true
