# ─────────────────────────────────────────────────────────────────────────────
# 测试环境（NODE_ENV=test）
#
# 与开发环境的**硬隔离**（这是本文件存在的全部意义）：
#   数据库  test.db     ≠ 开发 dev.db
#   上传目录 uploads-test ≠ 开发 uploads
#   备份目录 backups-test ≠ 开发 backups
#   日志目录 logs/test   ≠ 开发 logs
#
# 为什么要分库：smoke-* 脚本会建账号、删任务、改订单。若与开发共用一个库，
# 一次测试就能把演示数据搅乱，且事后无法区分「测试污染」与「真实 bug」。
#
# ⚠ 本档位**刻意不回落 `.env` / `.env.local`**（见 src/config/env-files.ts）。
# 共享 .env 里写着的 DATABASE_URL=file:./dev.db 一旦被继承，隔离就形同虚设。
#
# 加载档位： .env.test.local > .env.test
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# 端口与开发档**相同**（4100）：两档不能同时跑，起测试档会停掉开发档。
# 隔离靠的是库/目录/密钥（见上），不是端口。为什么不用独立端口：
# 端口一变，冒烟脚本、CORS 白名单、前端代理都要跟着改，忘一处就静默连错实例。
PORT=4100
HOST=127.0.0.1
API_PREFIX=api/v1

# ── 数据库（测试库，可随时删库重建）────────────────────────────────────────────
DATABASE_URL=file:./test.db

# ── 运行期目录 ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads-test
BACKUP_DIR=backups-test

# ── CORS ────────────────────────────────────────────────────────────────────
# 测试前端与开发档同为 5100（见 frontend/.env.test），默认白名单已放行，
# 这里仍显式写出：换端口时不必再想「默认白名单覆盖到没有」
CORS_ORIGINS=http://localhost:5100,http://127.0.0.1:5100
CORS_ALLOW_PRIVATE_LAN=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 测试环境用自己的密钥：这样测试 token 与开发 token 互不通用，
# 顺手也验证了「换密钥后旧 token 失效」这条行为
JWT_SECRET=test-only-secret-do-not-reuse-in-prod
JWT_TTL=1h

# ── 后台管理员预设（仅 development/test）──────────────────────────────────
# 与开发档保持一致；测试库重置后 seed:admin 会自动创建。
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=123456789

# ── 前端站点基址（邮件里的重置链接用）──────────────────────────────────────
# 必须填用户浏览器能打开的地址；改域名/反代后同步修改
WEB_BASE_URL=http://localhost:5100

# ── 邮件通道 ────────────────────────────────────────────────────────────────
# console = 不发网络请求，正文写入 logs/outbox/email-*.log（开发/测试默认）
# http    = POST 到 EMAIL_API_URL，需同时给 EMAIL_API_KEY
# aliyun  = 直调阿里云 SingleSendMail（需下方 ALIYUN_* 凭据）
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@huojue.local

# ── 短信通道 ────────────────────────────────────────────────────────────────
# console = 验证码写入 logs/outbox/sms-*.log（开发打印验证码，生产不打印）
# http    = POST 到 SMS_API_URL，需同时给 SMS_API_KEY
# aliyun  = 直调阿里云 SendSms（需下方 ALIYUN_* 凭据）
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=货觉AI
SMS_TEMPLATE=

# ── 阿里云短信 / 邮件 ───────────────────────────────────────────────────────
# 测试档一律留空：冒烟脚本不依赖真实短信/邮件，跑测试不能发到真人手机上
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_DM_ADDRESS_TYPE=1

# ── 支付通道 ────────────────────────────────────────────────────────────────
# sandbox 不产生真实资金流转；alipay / wechat 需补齐对应凭据。
# 凭据缺失时发起支付返回 503，不会静默降级为沙箱。
PAYMENT_PROVIDER=sandbox
PAYMENT_NOTIFY_BASE=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=log
LOG_DIR=logs/test
LOG_RETENTION_DAYS=3
LOG_MAX_FILE_MB=20
LOG_MAX_FILES_PER_DAY=5
LOG_CONSOLE=1
LOG_ERROR_FILE=1

# ── 图像生成网关 ─────────────────────────────────────────────────────────────
# 测试默认不连真实网关：外部依赖会让冒烟结果不确定
GATEWAY_BASE_URL=
GATEWAY_TOKEN=
GATEWAY_MODEL=
GATEWAY_ENABLED=
GATEWAY_TIMEOUT_MS=120000
GATEWAY_POLL_MS=2000
GATEWAY_MAX_POLLS=60
ASSET_PUBLIC_BASE=

# ── 存储后端 ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=huojue
# 测试档：限流保持开启（冒烟脚本据此断言 429），签名关闭（既有冒烟按公开路径取图）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
ASSET_SIGNING_SECRET=
ERROR_WEBHOOK_URL=

# 测试档调高：一条冒烟链路要建多个账号，生产配额会把测试自己挡住
RATE_LIMIT_AUTH_PER_MIN=200
# 测试辅助接口令牌：POST /api/v1/test/rate-limit/reset（NODE_ENV 非 test 时该路由直接 404）
# 冒烟脚本用它在开始/结束各清一次计数，避免「短信 5 次/天」被上一次运行吃光
RATE_LIMIT_RESET_TOKEN=test-reset-token
