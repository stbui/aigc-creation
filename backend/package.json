{
  "name": "ecom-vision-mvp-backend",
  "version": "1.0.0",
  "description": "智能电商图片与商品视觉生成平台 - MVP 后端 (NestJS + Prisma + SQLite + Jimp)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start",
    "start:test": "NODE_ENV=test node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "db:push:dev": "NODE_ENV=development npm run prisma:push",
    "db:push:test": "NODE_ENV=test npm run prisma:push",
    "db:push:prod": "NODE_ENV=production npm run prisma:push",
    "db:reset:test": "node scripts/reset-test-env.js",
    "db:migrate:provider": "node scripts/migrate-provider-values.js",
    "db:migrate:tool-idempotency": "node scripts/migrate-tool-idempotency.js",
    "seed:test": "NODE_ENV=test npm run seed:all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "seed": "ts-node -T scripts/seed-dev-user.ts",
    "seed:admin": "ts-node -T scripts/seed-admin.ts",
    "seed:roles": "ts-node -T scripts/seed-roles.ts",
    "seed:all": "npm run seed && npm run seed:roles && npm run seed:admin && npm run seed:commerce && npm run seed:membership && npm run seed:marketing && npm run seed:messages",
    "verify:deps": "node scripts/verify-deps.js",
    "verify:deps:critical": "node scripts/verify-deps.js --critical",
    "seed:commerce": "ts-node -T scripts/seed-commerce.ts",
    "seed:membership": "ts-node -T scripts/seed-membership.ts",
    "seed:marketing": "ts-node -T scripts/seed-marketing.ts",
    "smoke:marketing": "node scripts/smoke-marketing.js",
    "seed:legal": "ts-node -T scripts/seed-legal.ts",
    "seed:messages": "ts-node -T scripts/seed-message-templates.ts",
    "verify:credits": "ts-node -T scripts/verify-credit-deduction.ts",
    "verify:credit-price": "ts-node -T scripts/verify-credit-price.ts",
    "verify:tool-contracts": "ts-node -T scripts/verify-tool-contracts.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jimp": "1.6.1",
    "@jimp/plugin-print": "1.6.1",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.0",
    "prisma": "7.10.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
