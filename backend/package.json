{
  "name": "huojue-backend",
  "version": "1.0.0",
  "description": "货觉AI 后端 (NestJS + Prisma + SQLite + Jimp)",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start",
    "start:test": "NODE_ENV=test node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "test": "npm run test:typecheck && vitest run",
    "test:typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push:dev": "NODE_ENV=development npm run prisma:push",
    "db:push:test": "NODE_ENV=test npm run prisma:push",
    "db:push:prod": "NODE_ENV=production npm run prisma:push",
    "db:reset:test": "node scripts/reset-test-env.js",
    "db:migrate:project-lifecycle": "node scripts/migrate-project-lifecycle.js",
    "db:migrate:tool-idempotency": "node scripts/migrate-tool-idempotency.js",
    "seed:test": "NODE_ENV=test npm run seed:all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "seed": "ts-node -T scripts/seed-dev-user.ts",
    "seed:admin": "ts-node -T scripts/seed-admin.ts",
    "seed:roles": "ts-node -T scripts/seed-roles.ts",
    "seed:all": "npm run seed && npm run seed:roles && npm run seed:admin && npm run seed:commerce && npm run seed:membership && npm run seed:marketing && npm run seed:messages && npm run seed:templates",
    "verify:deps": "node scripts/verify-deps.js",
    "verify:deps:critical": "node scripts/verify-deps.js --critical",
    "seed:commerce": "ts-node -T scripts/seed-commerce.ts",
    "seed:membership": "ts-node -T scripts/seed-membership.ts",
    "seed:marketing": "ts-node -T scripts/seed-marketing.ts",
    "smoke:marketing": "node scripts/smoke-marketing.js",
    "smoke:payments": "node scripts/smoke-payments.js",
    "seed:messages": "ts-node -T scripts/seed-message-templates.ts",
    "seed:templates": "ts-node -T scripts/seed-template-catalog.ts",
    "import:templates": "ts-node -T scripts/import-portrait-templates.ts",
    "verify:billing": "ts-node -T scripts/verify-billing.ts",
    "verify:credits": "ts-node -T scripts/verify-credit-deduction.ts",
    "verify:credit-price": "ts-node -T scripts/verify-credit-price.ts",
    "verify:tool-contracts": "ts-node -T scripts/verify-tool-contracts.ts",
    "verify:plugin-manifests": "ts-node -T scripts/verify-plugin-manifests.ts",
    "verify:model-consistency": "ts-node -T scripts/verify-model-consistency.ts",
    "verify:payment-bills": "ts-node -T scripts/verify-payment-bills.ts",
    "verify:payment-signatures": "ts-node -T scripts/verify-payment-signatures.ts",
    "verify:channel-flow": "ts-node -T scripts/verify-channel-flow.ts",
    "verify:protocol-runtime": "ts-node -T scripts/verify-protocol-runtime.ts",
    "verify:route-catalog": "ts-node -T scripts/verify-route-catalog.ts",
    "verify:task-runtime": "ts-node -T scripts/verify-task-runtime.ts",
    "verify:proxy-runtime": "ts-node -T scripts/verify-proxy-runtime.ts",
    "reconcile:preconnection": "ts-node -T scripts/reconcile-preconnection-network-failures.ts"
  },
  "dependencies": {
    "@jimp/plugin-print": "1.6.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/client": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "5.2.1",
    "jimp": "1.6.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "7.0.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "12.1.3",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.10",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
