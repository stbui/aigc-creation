// Prisma schema for huojue backend.
// 说明: SQLite provider 不支持 Prisma enum 类型, 因此 capability / status / kind
// 使用 String 存储, 取值范围在 DTO / service 层通过白名单强制约束。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// 邮箱归属验证时间。注册必须完成邮箱验证码；OAuth 仅在该字段有值时才视为已验证。
  emailVerifiedAt DateTime?
  passwordHash    String
  name            String
  createdAt       DateTime  @default(now())

  // ── 后台权限与账号状态 (admin-prd.md §5.3) ──────────────────────
  // SQLite 无 enum, 取值由 DTO/service 层白名单约束:
  //   role:   'user' | 'admin' | 'operator' | 'finance'
  //   status: 'active' | 'disabled' | 'deleted'
  // role 不写入 JWT: AdminGuard 每次请求查库, 保证降权/禁用后旧 token 立即失效。
  role        String    @default("user")
  status      String    @default("active")
  lastLoginAt DateTime?

  // ── 邀请分销 (M11) ────────────────────────────────────────────────
  // 本人的邀请码, unique。**邀请码 → 邀请人的唯一索引**。
  // 必须落在 User 而非只存 InviteRelation: 只存关系表的话, 一个从未成功
  // 邀请过他人的用户没有任何码可被查到, 就无法生成属于自己的邀请链接 ——
  // "我邀请了 0 人"与"我没有邀请码"是两回事, 只有前者允许码不存在。
  inviteCode String? @unique

  projects Project[]
  assets   Asset[]
  tasks    GenerationTask[]

  // 交易域关系
  orders       Order[]
  payments     Payment[]
  cancelEvents OrderCancelEvent[]
  refunds      Refund[]
  invoices     Invoice[]
  lots         CreditLot[]
  ledger       CreditLedger[]

  // 会员体系关系
  memberships     Membership[]
  membershipUsage MembershipUsage[]

  // 营销域关系 (M11)。命名区分: 一个人既是别人的邀请人, 也是别人的被邀请人
  inviteRelationsAsInviter InviteRelation[] @relation("InviterRelations")
  inviteRelationAsInvitee  InviteRelation?  @relation("InviteeRelation")
  checkins                 CheckinRecord[]

  // ── 账号安全 (B2) ────────────────────────────────────────────────────
  // 令牌版本: 改密 / 重置密码 / 注销时 +1, JwtAuthGuard 逐请求比对签发时的版本。
  // 不存「已失效 token 黑名单」: 黑名单需要按 TTL 清理且体积不可控, 而
  // 「一次性作废该用户的全部旧会话」用单调递增的版本号即可, O(1) 判定。
  tokenVersion          Int       @default(0)
  /// 后台重置密码后置 true：登录仍成功，但在改密前只能访问 /me 与 /me/password。
  /// 忘记密码自助重置、用户主动改密、下一次后台重置都会写回 false。
  mustChangePassword    Boolean   @default(false)
  /// 后台一次性临时密码的到期时间；到期后登录直接拒绝，需重新联系管理员重置。
  tempPasswordExpiresAt DateTime?
  /// 手机号 —— 短信登录用。可空(存量账号无手机号), 非空时必须唯一
  phone                 String?   @unique
  phoneVerifiedAt       DateTime?

  /// 第三方 OAuth 身份（通用 OAuth 登录用，一个账号可绑定多个 provider）
  oauthIdentities OAuthIdentity[]

  accountTokens AccountToken[]
  loginLogs     LoginLog[]
  /// 扫码登录会话 (B8)
  loginSessions LoginSession[]

  consents      ConsentRecord[]
  notifications Notification[]

  /// 用户提交的工单 (B7)
  tickets Ticket[]

  @@index([role])
  @@index([status])
}

// ── 通用 OAuth 身份（第三方登录）────────────────────────────────────
// provider 如 'google' | 'github' | 'generic'，subject 为 provider 侧用户唯一 id。
// (provider, subject) 唯一：防止同一第三方账号被同时建出两个本地账号。
model OAuthIdentity {
  id          String    @id @default(cuid())
  userId      String
  /// 'google' | 'github' | 'generic' —— 取值由 OAuth registry 白名单约束
  provider    String
  /// provider 侧唯一 id（Google/GitHub 的数字 id 也按字符串存，避免跨平台溢出）
  subject     String
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// OAuth 一次性挑战。state 与登录票都只落 HMAC，兑换后 CAS 作废。
/// 这样即使浏览器历史、代理日志或前端 URL 泄露了原值，也无法重放第二次。
model OAuthChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  /// state | ticket
  kind       String
  provider   String
  /// 普通登录票的目标用户；linkUserId 只表示显式绑定发起人
  userId     String?
  /// 发起绑定流程时的当前登录用户；普通登录为空
  linkUserId String?
  returnTo   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, expiresAt])
}

// ── 后台角色与权限点 (admin-detailed-design.md §0.3) ──────────────
// permissions 存 JSON 数组字符串, 形如 ["user.write","order.refund"]。
// builtIn=true 的内置角色不可删除, 仅可调整权限点。
model AdminRole {
  id          String   @id @default(cuid())
  code        String   @unique // 'admin' | 'operator' | 'finance'
  name        String
  permissions String   @default("[]") // JSON 数组
  builtIn     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── 操作审计 (admin-detailed-design.md §16.2) ─────────────────────
// 只允许 INSERT: 后端不提供删除接口, 表设计上亦不设 updatedAt。
// 已知限制: 管理员仍可直接操作数据库删除, 彻底解决需独立存储或哈希链。
// ── 运行时配置 (admin-detailed-design.md §0.7) ──────────────────────
// 站点名/上传上限/生成参数/安全策略等可后台调整项。
// 优先级链: 代码默认值 (settings.dto.ts 的 SETTING_DEFS) → 本表的运行时覆盖。
// key 必须是 SETTING_DEFS 中登记过的项, service 层会拒绝未登记的键。
// ════════════════════════════════════════════════════════════════════════════
// 交易域 (admin-prd.md §3.6~3.9)
//
// 口径决策 (2026-07-20, 用户确认):
//   · **只做积分消耗制** —— 按能力逐项配置消耗积分, 无次数包/订阅包。
//     Product 只承载「积分数 + 有效期 + 发放方式」。
//   · **沙箱支付** —— M8 提供 /pay/sandbox 模拟成功/失败/超时,
//     真实通道留待 M15(需商户号)。
//
// 四条不可动摇的约定 (PRD §5):
//   1. 余额唯一由 CreditLot 汇总推导, **不存冗余余额字段** ——
//      冗余余额必然与批次不一致, 对账时无从判断该信哪个。
//   2. 金额一律整数分, 不用浮点 —— 浮点累加会产生分位误差。
//   3. OrderItem 全字段快照 —— 商品改价不影响历史订单。
//   4. 订单与交易信息保存≥3 年 (《电子商务法》), **不参与数据清理**。
// ════════════════════════════════════════════════════════════════════════════

/// 商品 (SKU)。
/// type: 'credits' 积分包。当前只支持这一类, 但保留字段便于后续扩展。
model Product {
  id          String @id @default(cuid())
  sku         String @unique
  name        String
  description String @default("")
  type        String @default("credits")

  /// 价格, 整数分。0 表示免费发放
  priceCents         Int
  /// 划线价, 整数分。用于展示优惠; 不参与任何计算
  originalPriceCents Int?
  /// 购买后获得的积分数
  credits            Int
  /// 积分有效期天数。0 = 永久有效(expireAt 为空, FEFO 视为最晚)
  creditsValidDays   Int    @default(0)
  /// 发放方式: 'immediate' 支付成功即发 | 'manual' 后台手动发放
  grantType          String @default("immediate")

  /// 'active' 上架 | 'offline' 下架。下架后 C 端不可购买, 历史订单不受影响
  status    String @default("active")
  /// 排序权重, 小的靠前
  sortOrder Int    @default(0)

  /// CNY | USD
  currency            String    @default("CNY")
  /// credits（本轮唯一启用）| storage（后续）
  kind                String    @default("credits")
  /// unlimited | periodic | inventory | timed
  saleStrategy        String    @default("unlimited")
  periodDays          Int       @default(0)
  periodPurchaseLimit Int       @default(0)
  stockTotal          Int       @default(0)
  stockReserved       Int       @default(0)
  stockSold           Int       @default(0)
  saleStartAt         DateTime?
  saleEndAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([status, sortOrder])
  @@index([status, kind, sortOrder])
}

/// 订单。
/// status 状态机 (PRD §5: 不可跳跃):
///   pending → paid → (refunded | partial_refunded)
///   pending → cancelled (超时未支付)
model Order {
  id             String @id @default(cuid())
  orderNo        String @unique
  userId         String
  /// 幂等键。同一用户重复提交返回同一订单, 不重复创建
  idempotencyKey String

  /// 订单应付总额, 整数分。由 OrderItem 汇总, 不随商品改价变化
  totalCents     Int
  /// 优惠金额, 整数分。= 券优惠 + 活动优惠。**下单时确定并写入快照**,
  /// 之后券规则/活动改价都不追溯 (admin-detailed-design.md §12.6)
  discountCents  Int @default(0)
  /// 实付金额, 整数分。= totalCents - discountCents
  /// 退款上限以此为准 (而非 totalCents), 否则用券订单会多退
  paidCents      Int @default(0)
  /// 已退款金额, 整数分。支持部分退款
  refundedCents  Int @default(0)
  /// 本单发放的积分数 (可能因退款回收而变化)
  grantedCredits Int @default(0)

  /// 核销的优惠券。规则以 CouponSnapshot 为准, 本字段仅作关联与统计
  couponId       String?
  /// 命中的限时活动 (限时价/限时免费)
  campaignId     String?
  /// **优惠规则快照** (JSON)。券或活动事后被改/删, 历史订单仍可还原当时规则 ——
  /// 不存快照的话改一次券价, 所有历史订单的优惠金额就都解释不清了
  couponSnapshot String  @default("{}")

  /// 'pending' | 'paid' | 'cancelled' | 'refunded' | 'partial_refunded'
  status  String @default("pending")
  /// 'sandbox' 沙箱 | 后续 'alipay' | 'wechat' | 'stripe'
  channel String @default("sandbox")

  paidAt    DateTime?
  /// 超时未支付自动关闭的时间点
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 订单币种；金额始终是最小单位（CNY 分 / USD 美分）
  currency String @default("CNY")

  /// 下单意图时固定的渠道配置版本。历史订单为空时回调按同渠道最新版兜底
  providerConfigId      String?
  providerConfigVersion Int?
  /// 下单时选中的服务商实例；历史订单可为空，恢复仍以 providerConfigId 为准
  providerInstanceId    String?

  /// 渠道交易号。回调/查单/对账均可反查；唯一约束是重复入账的第二道防线
  providerTradeNo String? @unique
  /// 渠道原始状态文本，仅展示与排障，不参与本地状态机
  providerStatus  String?

  /// redirect | qrcode | sandbox
  checkoutMode      String?
  /// 跳转 URL 或二维码载荷。终态必须清空为 ''，避免页面把过期链接当可用
  checkoutValue     String?   @default("")
  checkoutExpiresAt DateTime?
  /// 最近一次向渠道查单的时间；用于 2 秒防抖与 worker 30 秒轮询
  lastQueriedAt     DateTime?

  /// 最近一次下单/查单/关单失败原因，截断 200 字；仅页面排障用
  lastError       String?
  /// 关单租约。条件更新抢占，防止用户手动关单与 worker 同时执行
  closeStartedAt  DateTime?
  /// 发起支付租约。覆盖「关闭旧尝试 → 渠道下单 → 写回本地」全过程，
  /// 防止并发请求各自在渠道创建一笔可支付订单；超时后可被新请求接管。
  intentStartedAt DateTime?
  closedAt        DateTime?

  /// 渠道侧支付时间；paidAt 仍是本地入账时间
  providerPaidAt DateTime?

  /// 是否仍占用库存。库存性商品下单时 true，支付/取消时释放
  stockReserved Boolean @default(false)

  user        User              @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  cancelEvent OrderCancelEvent?
  refunds     Refund[]
  coupon      Coupon?           @relation(fields: [couponId], references: [id])
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])

  // 会员体系: 一个订单可同时是"购买会员的订单"(SubscriptionOrder) 与
  // "使用会员折扣的商品订单"(PlanOrders)
  membership          Membership?       @relation("SubscriptionOrder")
  membershipPlanId    String?
  membershipPlan      MembershipPlan?   @relation("PlanOrders", fields: [membershipPlanId], references: [id])
  membershipUsage     MembershipUsage[]
  /// 发票: 保留每次申请历史; 同一订单同时最多一张有效票
  invoices            Invoice[]
  /// 会员权益开始发放的时刻。**该订单是否已兑换会员的唯一凭据**。
  ///
  /// 不能靠 Membership.orderId 判断: 同一用户续费时复用同一条 Membership 行,
  /// orderId 会被后一笔订单覆盖 —— 旧订单因此"看起来没被用过", 重放它就能
  /// 再白拿一期会员与月度积分。此字段与订单同生命周期, 不会被覆盖。
  membershipAppliedAt DateTime?

  /// 本订单实际兑换出的会员周期快照。续费同样复用 Membership 行, 因此
  /// 退款时不能从当前会员反推某笔历史订单买了哪一段时间。
  /// 权益与周期天数在下单时快照；后续运营改套餐只影响新订单。
  membershipPeriodStartAt          DateTime?
  membershipPeriodEndAt            DateTime?
  membershipPerksSnapshot          String?
  membershipMonthlyCreditsSnapshot Int?
  membershipDurationDaysSnapshot   Int?
  /// 下单时套餐映射的用户分组编码。空串表示默认分组。
  /// 分组承载渠道可见性、价格倍率与兑换比例，必须与权益一起冻结；
  /// 否则运营改套餐映射会追溯改变已付费用户的可用渠道和计费倍率。
  membershipUserGroupCodeSnapshot  String?
  /// 全额退款撤销本周期的时间。为 null 且订单仍为 paid/partial_refunded
  /// 才代表该周期仍有效；保留字段用于退款后审计周期边界。
  membershipPeriodRevokedAt        DateTime?

  @@unique([userId, idempotencyKey])
  @@index([membershipPlanId])
  @@index([userId, status])
  /// 我的订单列表：按用户 + 时间倒序分页
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([couponId])
  @@index([campaignId])
  @@index([channel, status, createdAt])
  @@index([channel, providerPaidAt])
  @@index([channel, paidAt])
  @@index([status, paidAt])
  @@index([providerPaidAt])
  @@index([status, expiresAt])
  @@index([providerConfigId])
  @@index([providerInstanceId])
  @@index([paidAt])
  @@index([closedAt])
}

/// 用户主动取消订单的额度预留记录。
///
/// `reserved` / `consumed` 都占用取消次数；关单失败时置为 `released` 归还额度。
/// 一个订单唯一一条记录，保证同一订单重试取消不会重复计数。
model OrderCancelEvent {
  id          String    @id @default(cuid())
  orderId     String    @unique
  userId      String
  /// reserved | consumed | released
  status      String    @default("reserved")
  /// rolling | fixed，预留时冻结，后续设置变更不追溯已占用额度
  windowMode  String
  /// 本次计数窗口的起点。固定窗口按窗口长度对齐；滚动窗口取预留时间
  windowStart DateTime
  windowEnd   DateTime
  reservedAt  DateTime  @default(now())
  consumedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, windowStart])
  @@index([userId, status, reservedAt])
}

/// 订单项 —— **全字段快照**。
/// 商品改价 / 改名 / 下架都不影响历史订单的展示与退款计算。
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // ── 快照字段 (下单时刻的值, 之后不再变化) ──
  skuSnapshot           String
  nameSnapshot          String
  priceCentsSnapshot    Int
  creditsSnapshot       Int
  validDaysSnapshot     Int
  /// 下单时的发放方式快照。支付成功时只能按此字段发分，不能读取 Product
  /// 的实时值；否则运营在待支付窗口内切换 immediate/manual 会追溯改变订单。
  /// null 仅用于兼容加列前创建的历史订单。
  grantTypeSnapshot     String?
  /// 下单时实际占用的库存数量。库存策略可能在待支付窗口内被后台修改，
  /// 支付/取消时必须按此快照归还或转已售，不能读取 Product.saleStrategy。
  /// 0 = 未占库存；null 仅用于兼容加列前创建的历史订单。
  stockReservedSnapshot Int?

  quantity Int @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// 支付流水。
/// 每次支付尝试一条, 失败的也留痕 —— 对账时"发起过但没成功"是必须可见的事实。
model Payment {
  id      String @id @default(cuid())
  orderId String
  userId  String

  /// 渠道交易号。**幂等去重键**: 已支付订单收到重复回调不重复发积分
  payTransactionId String? @unique
  channel          String  @default("sandbox")
  /// 本次尝试对应的 C 端支付方式：alipay / wechat。
  /// EasyPay 同一商户可承载两种方式，回调验签必须读取这笔历史尝试，而不是最新渠道配置。
  providerMethod   String?
  amountCents      Int

  /// 'pending' | 'succeeded' | 'failed' | 'closed'
  status          String  @default("pending")
  /// 失败原因 / 沙箱场景标记
  message         String?
  /// 沙箱特有: 模拟的场景标识, 真实通道为 null
  sandboxScenario String?
  /// 渠道原始回调报文 (JSON 字符串, 已验签)。
  ///
  /// 对账差异申诉时, 这是唯一能自证的原始凭据 —— 事后渠道侧改口径、
  /// 或本地订单被误改, 都只能靠它还原「当时收到的到底是什么」。
  /// 报文里可能含渠道侧的敏感字段, 故**只落库, 不进审计 detail 与接口响应**。
  rawPayload      String  @default("")

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 本次支付尝试的币种（必须与订单一致）
  currency              String    @default("CNY")
  /// 本次尝试固定的渠道配置版本；渠道配置轮换后仍可回溯
  providerConfigId      String?
  providerConfigVersion Int?
  /// 本次尝试选中的服务商实例；历史记录可为空
  providerInstanceId    String?
  /// 渠道侧下单返回的单据 id（PayPal order id / Stripe Checkout Session id 等）。
  /// 查单、关单和退款不能只依赖商户订单号，部分渠道必须用该 id 反查。
  providerRef           String?
  /// 渠道原始状态文本，仅排障展示
  providerStatus        String?
  /// 单次支付尝试的失败原因
  lastError             String?
  closedAt              DateTime?

  order   Order    @relation(fields: [orderId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([userId])
  @@index([orderId, status])
  @@index([providerInstanceId])
}

/// 退款单。
/// 退款按 CreditLot.remaining 逐批扣回 —— 退的是"还没花掉的部分"。
model Refund {
  id        String @id @default(cuid())
  orderId   String
  paymentId String
  userId    String

  amountCents          Int
  /// 扣回的积分数(可能小于发放数 —— 已消耗的部分无法扣回)
  creditsReclaimed     Int @default(0)
  /// 因已消耗而无法扣回的积分数。必须如实记录, 否则对账会以为系统丢积分
  creditsUnreclaimable Int @default(0)

  status           String   @default("succeeded")
  reason           String
  operatorId       String
  /// 渠道退款单号。沙箱退款为空 —— 它与 payTransactionId 一起构成
  /// 「这笔钱确实原路退回」的外部证据, 本地状态机无法自证。
  providerRefundId String?
  /// 逐批次扣回明细, JSON: [{lotId, taken, ...}]
  detail           String   @default("{}")
  createdAt        DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

/// 积分批次。
/// **批次可用余额 = Σ remainingMicrocredits (未过期的批次)**；用户级余额以
/// `CreditAccount.availableMicrocredits` 为准，二者由每日对账任务校验相等。
/// 金额一律微积分（1 积分 = 1,000,000），任务账单的预留/结算可以落在 1 微积分精度。
model CreditLot {
  id     String @id @default(cuid())
  userId String

  /// 批次来源: 'purchase' 购买 | 'grant' 发放 | 'admin_adjust' 人工 | 'refund_reclaim' 退款扣回
  source  String
  /// 关联订单。购买积分批次指向购买单；会员月度积分批次指向该发分
  /// 时点所属的会员周期订单，退款按此精确回收。
  orderId String?

  totalMicrocredits     BigInt
  remainingMicrocredits BigInt
  /// 到期时间。**为空视为最晚到期** (FEFO 排序时排最后)
  expireAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  ledger CreditLedger[]

  @@index([userId, expireAt])
  @@index([expireAt])
  @@index([orderId])
}

/// ⚠️ **已废弃的旧流水表，不要写入。**
///
/// 当前积分流水的唯一事实来源是 `CreditLedgerEntry`（微积分口径，含
/// available/reserved 变动与变动后快照）。本表用 Int 积分、缺 reserved 维度，
/// 无法与 `CreditAccount` / `CreditLot` 对齐，全仓已无任何代码引用。
///
/// 保留原因：历史数据尚未迁移清理。**禁止新增写入或读取** ——
/// 新旧两张流水表并存且都自称「唯一事实来源」，是后续误读的最大来源。
/// 清理计划：随下一次数据迁移把历史行并入 `CreditLedgerEntry` 后 drop。
model CreditLedger {
  id     String @id @default(cuid())
  userId String

  /// 'consume' 消耗 | 'purchase' 购买获得 | 'grant' 发放
  /// | 'admin_adjust' 人工增减 | 'refund_reclaim' 退款扣回 | 'expire' 到期回收
  type         String
  /// 变动量。消耗为负, 获得为正 —— 单一符号约定避免正负混淆
  amount       Int
  /// 变动后的可用余额快照。仅用于流水展示与快速核对,
  /// **不作为余额来源** (余额永远从 CreditLot 推导), 出现不一致时以批次为准
  balanceAfter Int

  /// 关联批次
  lotId          String?
  orderId        String?
  taskId         String?
  /// 资金/积分动作幂等键。退款按 taskId 生成稳定键，重复调用只能落一条流水。
  idempotencyKey String? @unique

  /// 人工调整备注。可选；留空时写系统说明，操作审计另行自动记录
  reason     String?
  operatorId String?

  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id])
  lot  CreditLot? @relation(fields: [lotId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
  @@index([orderId])
  @@index([taskId])
}

// ════════════════════════════════════════════════════════════════════════════
// 会员体系 (落地页订阅卡兑现)
//
// 口径决策 (2026-07-20, 用户确认):
//   · **订阅制会员** —— 按周期生效, 独立于「积分消耗制」商品。
//     Product 仍只承载积分 (PRD §3.6 约束不变), 会员另走一套表。
//   · 落地页承诺的 4 项权益全部实现: 快速通道 / 并发上限 / 加油包 95 折 / 订阅积分。
//
// 设计取舍:
//   · **perks 存 JSON 而非拆表** —— 权益是可变的运营配置, 拆表会让
//     "加一种权益"变成改表 + 加关联 + 改查询。JSON 单字段便于整体读写,
//     代价是失去 DB 层校验 —— 故在 service 层做严格校验。
//   · **权益快照落在 Membership 上**: 续期/降级只改 expiresAt 与 planId,
//     不动 perks; 若运营改了套餐权益, 存量会员不受影响 (已付的钱要对得起)。
// ════════════════════════════════════════════════════════════════════════════

/// 会员套餐(等级定义)。
model MembershipPlan {
  id             String @id @default(cuid())
  code           String @unique // 套餐编码: free / basic / advanced / pro / studio / flagship / supreme
  name           String
  description    String @default("")
  /// 价格, 整数分。free 为 0
  priceCents     Int    @default(0)
  /// 周期天数。0 = 永久(free)
  durationDays   Int    @default(0)
  /// 每月发放的订阅积分
  monthlyCredits Int    @default(0)

  /// 权益(JSON)。字段定义见 MembershipService.PERKS_SCHEMA:
  ///   fastChannel: bool              是否走快速通道
  ///   maxConcurrent: number          同时进行中任务上限 (0 = 不限)
  ///   addonDiscountBps: number       加油包折扣万分比 (9500 = 95 折, 10000 = 无折扣)
  perks String @default("{}")

  /// 会员套餐映射的用户分组（UserGroup.code）。空串 = 默认分组。
  /// 分组承载渠道可见性、倍率与货币兑换比例，见 docs/channel-model-design.md §14
  userGroupCode String @default("")

  /// 'active' 上架 | 'offline' 下架。下架不影响存量会员
  status    String @default("active")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  /// 指向本套餐的订单。显式命名, 因为 Order 同时还通过 Membership 关联本套餐
  orders      Order[]      @relation("PlanOrders")

  @@index([status, sortOrder])
}

/// 用户当前订阅。
/// 一个用户同时最多一条 status ∈ ('active','grace') 的订阅 (service 层保证)。
model Membership {
  id     String @id @default(cuid())
  userId String
  planId String

  /// 权益快照。下单时从 plan.perks 复制 —— 运营改套餐不影响存量会员
  perksSnapshot          String @default("{}")
  monthlyCreditsSnapshot Int    @default(0)

  startAt   DateTime
  expiresAt DateTime
  /// 'active' 生效中 | 'grace' 已过期但仍在宽限期 | 'expired' 已失效 | 'cancelled' 已取消
  status    String   @default("active")
  /// 关联的支付订单 (订阅购买)。一订单最多生成一条订阅 —— unique 是 Prisma 一对一关系的必需项
  orderId   String?  @unique

  /// 下次发放订阅积分的时间。调度器据此每月发积分
  nextCreditAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id])
  plan  MembershipPlan @relation(fields: [planId], references: [id])
  order Order?         @relation("SubscriptionOrder", fields: [orderId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([nextCreditAt])
}

/// 会员权益使用记录 (会员消费额)。
/// 用于会员页展示「累计省了多少」, 也是后续等级制的升级依据。
model MembershipUsage {
  id         String  @id @default(cuid())
  userId     String
  /// 一订单最多一条使用记录 —— 一个订单只能享受一次会员折扣
  orderId    String? @unique
  /// 本单因会员折扣节省的金额(分)
  savedCents Int     @default(0)
  /// 使用的套餐 code 快照
  planCode   String  @default("")

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String // 统一以字符串存储, 读取时按 SettingDef.type 解析
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ── 数据备份 (admin-prd.md B-96/97/98) ──────────────────────────────
// 备份文件落盘在 backend/backups/, 本表只存元数据。
//
// status 的意义: B-97 要求"每份备份须有恢复验证记录, 无验证记录的备份视为无效"。
// 因此 verified=false 的记录在 UI 上必须显式标为「未验证」, 且不提供下载入口 ——
// 未经校验的文件在事故时才发现损坏就晚了。
model BackupRecord {
  id              String  @id @default(cuid())
  filename        String  @unique
  /// 字节数。用于保留份数清理时估算磁盘占用
  sizeBytes       Int
  /// SHA-256 十六进制。事故恢复时用于确认文件未被篡改/损坏
  sha256          String
  /// 'manual' | 'scheduled'
  trigger         String  @default("scheduled")
  /// 'pending' | 'succeeded' | 'failed'
  status          String  @default("pending")
  errorMessage    String?
  /// 备份来源库的大小, 用于确认快照确实落下了数据
  sourceSizeBytes Int?

  // ── 恢复验证 (B-97) ─────────────────────────────────────────────
  /// 是否已通过恢复验证。B-97: 无验证记录的备份视为无效
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  /// 验证结论摘要, 如 "integrity_check=ok; 表计数一致"
  verifyReport   String?
  /// 验证器给出的警告 (如缺少索引), 不阻断验证通过但需人工判断
  verifyWarnings String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([verified])
  @@index([createdAt])
}

// ── 到期数据清理留痕 (B-100) ──────────────────────────────────────
// 清理是不可逆操作, 必须留痕: 删了什么、删了多少、谁触发。
// 同时用于回答"某条数据是什么时候没的"。
model CleanupLog {
  id            String   @id @default(cuid())
  /// 被清理的数据类别, 见 RETENTION_TARGETS
  target        String
  /// 本次删除的条数
  deletedCount  Int
  /// 清理依据的保留天数 (便于事后核对配置是否被改过)
  retentionDays Int
  /// 'scheduled' | 'manual'
  trigger       String   @default("scheduled")
  /// 跳过条数: 满足清理条件但被保护规则豁免的 (如订单受法定留存约束)
  skippedCount  Int      @default(0)
  detail        String   @default("{}")
  success       Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([target])
  @@index([createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String // 'user.disable' | 'order.refund' | 'credit.adjust' ...
  targetType String
  targetId   String
  detail     String   @default("{}") // JSON: 操作前后的关键字段
  reason     String? // 高危动作的操作原因
  ip         String
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Project {
  id        String    @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime  @default(now())
  /// 软删除时刻。素材保留用于追溯，但项目本身不再对用户可见/可用。
  deletedAt DateTime?

  owner  User             @relation(fields: [ownerId], references: [id])
  assets Asset[]
  tasks  GenerationTask[]

  @@index([ownerId, deletedAt])
  @@index([deletedAt])
}

model Asset {
  id         String   @id @default(cuid())
  projectId  String
  ownerId    String
  kind       String // 'original' | 'generated'
  capability String? // 仅 generated: 'main_image' | 'detail_image' | 'matting'
  sourceUrl  String
  width      Int?
  height     Int?
  format     String // mime, e.g. image/jpeg
  sizeBytes  Int
  /// 视频时长 (毫秒) —— 仅 video 模态有值 (2026-10-20)
  ///
  /// ⚠️ 可空而非默认 0: 0 与"未记录"语义不同 (0 长的视频不存在)。
  /// 图像/文本产出该字段恒为 null, 调用方按模态判断是否读它。
  durationMs Int?
  createdAt  DateTime @default(now())

  // ── 素材管理 (admin-prd.md §3.4 B-23~B-27) ───────────────────────
  // status: 'visible' | 'hidden'。下架后用户端列表不再展示, 但文件与记录保留 ——
  // 误下架可恢复, 删除则不可逆, 两者必须区分。
  status String @default("visible")

  // ── 存储后端 (src/storage) ───────────────────────────────────────
  // storageBackend: 'local' | 'oss' | 'minio'
  // 素材记录**必须记住写入时的后端**: 默认后端切换后, 老素材仍要从原后端读。
  // 不加这个字段, 切换 STORAGE_BACKEND 会让全部历史素材 404。
  storageBackend String  @default("local")
  // storageKey 是唯一真相 (如 original/202610/abc123.jpg);
  // sourceUrl 保留为可访问路径, 但切换域名/CDN 时只需改配置, 不必刷库。
  storageKey     String?

  // ── 来源元数据 (浏览器扩展采集, 2026-10-30) ──────────────────────
  // 只在浏览器扩展「图片采集」上传 original 素材时写入, 其余入口恒为 null。
  // 三者都是用户可见的溯源信息: 素材库卡片展示站点/标题并链接回原页面。
  //
  // ⚠️ 仅作展示与溯源, **不参与鉴权、不用于服务端抓取** —— 存的是用户浏览页的
  // 描述性文本, 服务端不能拿它当可信输入 (sourcePageUrl 只允许 http/https)。
  /// 来源站点 (主机名去掉 www., 如 `taobao.com`), 最长 255
  sourceSite    String?
  /// 来源页面标题, 最长 500
  sourceTitle   String?
  /// 来源页面 URL, 最长 2048, 仅 http/https
  sourcePageUrl String?

  // ── AIGC 内容标识 (B5, 2026-10-21) ──────────────────────────────
  /// 生成式合成标识落盘结果 (JSON 字符串)。
  ///
  /// 形如 `{ labeled: true, method: 'png-text+xmp', metadata: true, visible: true }`。
  /// 只对 **generated** 素材写入; original (用户上传) 恒为 `{}` ——
  /// 给用户上传的图打 AI 标识等于诬告, 比不标更糟。
  aigcMeta      String    @default("{}")
  /// 标识写入完成时刻 (null = 未标注或标注失败)
  aigcLabeledAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  // 1:1 反向关系: 该 Asset 是某个 GenerationTask 的输出
  outputOfTask GenerationTask? @relation("TaskOutputAsset")

  @@unique([storageBackend, storageKey])
  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  /// 素材库列表 / 计数热路径：owner + 可见状态 + 时间倒序
  @@index([ownerId, status, createdAt])
  @@index([storageBackend])
  @@index([capability])
  @@index([createdAt])
}

model GenerationTask {
  id             String  @id @default(cuid())
  projectId      String
  ownerId        String
  capability     String // 'main_image' | 'detail_image' | 'matting'
  /// 'queued' | 'running' | 'succeeded' | 'failed' | 'cancelled'
  ///
  /// `queued` 是「已预留积分、等待 worker 领取」；`running` 由 worker 以
  /// 条件更新领取时写入。终态只有 succeeded / failed / cancelled 三种。
  status         String
  inputAssetIds  String // JSON 数组字符串
  outputAssetId  String? @unique // 1:1, 需 unique 约束
  /// 多变体产出的有序素材 id 数组 (JSON)。首项与 outputAssetId 相同。
  /// 多图融合一次任务可产出 1-4 张真实变体；保留 outputAssetId 兼容既有
  /// 历史、后台和 1:1 关系，本字段只扩展“同一任务的其它产出”。
  outputAssetIds String?
  params         String // JSON 对象字符串
  /// 历史供应商标识。新链路以 channelModelId / routeId 快照为准，本字段仅为
  /// 兼容存量数据保留，避免数据库升级时删除仍有审计价值的历史值。
  provider       String?
  errorCode      String?
  // 本次实际扣掉的积分数快照 (0 = 免费)。用于后台展示与退款核算
  creditCost     Int     @default(0)

  /// 同一次生成的父任务 id。
  ///
  /// 一次提交按模块拆成多张图时, 只有首张任务承担计费; 其余任务
  /// `creditCost = 0`、无账单, 用本字段悬挂在父任务下。前端按 `batchId`
  /// 参数把整批聚合成「一次生成」展示。
  ///
  /// 与 `retriedFromId` 同理不建外键: 父任务被删除后子任务仍要能读出
  /// 自己的批次归属, 加 FK 会让父任务一删就连带失败。
  parentTaskId       String?
  /// 请求幂等键。与 ownerId 组成唯一约束，客户端重试不能重复建任务/扣费。
  idempotencyKey     String?
  /// 原始生成请求的稳定指纹；同一 owner 的幂等键只能复用完全相同的请求
  requestFingerprint String?

  // ── 任务监控 (admin-prd.md B-32 重试) ────────────────────────────
  // 本任务由哪个失败任务重试而来 (null = 用户首次发起)。
  //
  // ⚠ 重试**必须新建任务而不是原地复活**:
  // outputAssetId 上有 @unique 的 1:1 约束, 原地复活会让新的产出图
  // 与旧的产出图抢同一个唯一键。此字段只作来源追溯, 不建外键 ——
  // 来源任务被清理后重试链仍要能读, 加 FK 会让来源一删就连带失败。
  retriedFromId String?
  /// 重试幂等键。每个来源任务最多派生一个重试任务，用于消除后台并发重试
  /// 的竞态；与面向调用方的 `idempotencyKey` 分开，避免污染用户请求语义。
  retryKey      String? @unique

  /// 执行期存活心跳。任务运行期间每 30s 写一次。
  ///
  /// 进程崩溃/重启后, 没有任何内存标记能告诉你"哪些任务已经死了" ——
  /// 它们会永远停在 running 占着并发额度, 而用户既没拿到图也拿不回积分。
  /// 调度任务 `task-recover` 依据它判定孤儿任务并回收退款。
  /// 不用 `updatedAt` 代替: 它会被任何无关的字段更新刷新, 无法区分
  /// "任务还在跑" 与 "有人改了一下这行"。
  heartbeatAt DateTime?

  // ── 模型路由快照 (P4-b) ────────────────────────────────────────────
  //
  // 任务一旦建成，供应侧字段就是**快照**: 后台改价 / 换线路 / 归档模型
  // 都不影响已建任务；重试只复用 logicalModelId 重新解析当前 revision。
  /// 前台模型 id（`LogicalModel.id`）。新建任务必填，存量历史任务为空。
  logicalModelId         String?
  /// 解析时命中的 revision id —— 同一次重试必须回到同一份能力合同
  logicalModelRevisionId String?
  /// 命中的线路 id（`LogicalRoute.id`）
  routeId                String?
  /// 命中的渠道模型 id（`ChannelModel.id`）
  channelModelId         String?
  /// 尝试轮次：用户手动重试 +1，故障切换不变（见 docs/channel-model-design.md §5.7）
  routeRun               Int     @default(1)

  /// 账单 id（`BillingOrder.id`）。故障切换会替换账单，故这里存**当前**账单。
  billingOrderId    String?
  /// 上游返回的任务 id。异步协议轮询与人工核对都依赖它
  providerRequestId String?
  /// 轮询阶段的人类可读描述（如「候车 · 前面 3 条」），仅用于展示
  pollStage         String    @default("")
  /// 下次回查上游的时间。为空表示当前 attempt 不需要轮询
  nextPollAt        DateTime?

  /// 租约持有者（`hostname:pid:rand`）。空串 = 无人持有
  leaseOwner                   String    @default("")
  /// 租约到期时间。过期即视为执行者已死，由 `task-recover` 按 dispatchState 分流
  leaseUntil                   DateTime?
  /// 已创建的尝试次数（`RouteAttempt` 计数快照，用于后台展示）
  attempts                     Int       @default(0)
  /// 当前阶段（`dispatch` / `poll` / `recover`），后台进度展示用
  stage                        String    @default("")
  /// 0-100 的粗粒度进度；上游不报进度时停在 5（已领取）
  progress                     Int       @default(0)
  /// 本次授权的扣费上限（微积分）。0 = 未设置，结算按实际用量
  authorizedChargeMicrocredits BigInt    @default(0)

  /// 产物回收失败的原始原因（下载 / 落盘 / 标识）。**不影响计费**:
  /// 上游已产出时归 `mediaRecoveryError`，任务延后重试而不切线路不退款。
  mediaRecoveryError String?
  /// 已拿到但尚未落盘的上游产出（`ProtocolResult` JSON）。
  ///
  /// 上游返回公网地址 / 内联字节后，宿主还要下载、标识、写存储、登记素材；
  /// 这一步失败时**不能重新派发**（上游已计费），也不能丢弃结果 —— 先把结果
  /// 存在这里，worker 下一轮直接续做落盘，不再回上游要第二次。
  pendingResult      String?

  /// AIGC 标识执行结果 (JSON 字符串)。与 Asset.aigcMeta 分开保存:
  /// 任务侧记的是「这次生成做了什么标识动作、失败原因」, 素材侧记的是
  /// 「这份文件最终带着什么标识」—— 两者在失败路径上会不一致, 合并就丢了现场。
  aigcMeta String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id])
  owner       User    @relation(fields: [ownerId], references: [id])
  // outputAsset 为 1:1 关系, 反向字段声明在 Asset 侧
  outputAsset Asset?  @relation("TaskOutputAsset", fields: [outputAssetId], references: [id])

  @@unique([ownerId, idempotencyKey])
  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  /// 后台任务监控高频组合: 状态 + 时间窗 / 用户 + 时间线
  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  // 孤儿任务回收按 (status, heartbeatAt) 扫描
  @@index([status, heartbeatAt])
  /// worker 领取与轮询回查: `status='queued'` 按 createdAt、`status='running'`
  /// 且 `nextPollAt` 到期才回查
  @@index([status, nextPollAt])
  /// 租约过期扫描: `status='running'` 且 `leaseUntil < now()`
  @@index([status, leaseUntil])
  /// 账单反查任务（后台对账 / 人工核对）
  @@index([billingOrderId])
  /// 批次子任务反查（父任务失败时级联取消 / 并发计数排除子任务）
  @@index([parentTaskId])
}

// ════════════════════════════════════════════════════════════════════
// 营销中心 (M11 · admin-prd.md B-64~B-67 / admin-detailed-design.md §12)
//
// 四张表: Coupon 优惠券 / Campaign 限时活动 / InviteRelation 邀请关系
//        + InviteRewardRule 邀请奖励规则 (单行配置)
// ════════════════════════════════════════════════════════════════════

/// 优惠券。
///
/// ⚠ **金额一律整数**: 满减/固定额用 `value`(分), 折扣用 `value`(万分比, 8500 = 85折)。
/// 浮点会在累加时产生分位误差 —— 与 Order/Payment 同一约定。
///
/// `usedCount` 只在**支付成功**时 +1；待支付订单以 pending 状态预占名额，
/// 取消/超时后自动释放，避免未付款订单永久消耗限量券。
model Coupon {
  id   String @id @default(cuid())
  /// 券码。用户手动输入, 大写规范化后唯一
  code String @unique
  name String

  /// 'full_cut' 满减 | 'discount' 折扣 | 'fixed' 固定额减免
  type           String
  /// full_cut/fixed: 减免分。discount: 折扣万分比 (8500 = 85折, 9000 = 9折)
  value          Int
  /// 使用门槛, 整数分。0 = 无门槛
  thresholdCents Int    @default(0)

  /// 适用范围: 'all' 全站 | 'product' 指定商品 | 'new_user' 仅新用户首单
  scope      String @default("all")
  /// scope='product' 时的商品 id 数组 (JSON)。scope≠product 时为空数组
  productIds String @default("[]")
  /// scope='new_user' 时定义「新用户」: 有过 paid 订单即非新用户。
  /// 判定走Order 表实时查询, 不额外打标 —— 打标会被历史数据修正搞脏

  /// 发行总量。0 = 不限量
  totalCount   Int @default(0)
  /// 已核销数量 (支付成功口径, 与 totalCount 同增同减)
  usedCount    Int @default(0)
  /// 每人限用。0 = 不限
  perUserLimit Int @default(1)

  validFrom DateTime
  validTo   DateTime
  /// 'on' 启用 | 'off' 停用。停用不影响已核销订单
  status    String   @default("on")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders Order[]

  @@index([status, validFrom, validTo])
  @@index([type])
}

/// 限时活动。
///
/// payload 按 type 约定 (JSON):
///   limited_price: { productId, priceCents }     —— 覆盖 Product.priceCents
///   limited_free:  { capabilityIds[] }            —— 指定能力限时免费
///   popup:         { title, body, ctaText, ctaUrl }
///
/// ⚠ **不落 Product 表**: 限时价只在结算时作为覆盖值参与计算, 不改商品本体价格。
/// 改本体价格会让活动到期后无法还原基准价, 且历史订单价格来源不可追。
model Campaign {
  id      String @id @default(cuid())
  name    String
  /// 'limited_price' 限时价 | 'limited_free' 限时免费 | 'popup' 弹窗位
  type    String
  payload String @default("{}")

  startAt  DateTime
  endAt    DateTime
  /// 'draft' 草稿 | 'active' 进行中 | 'ended' 已结束 | 'off' 已下线
  /// active 不代表生效 —— 是否命中仍看时间窗与 payload (草稿态 active 是允许的编辑中间态)
  status   String   @default("draft")
  /// 投放人群。空对象 = 全站。{ onlyNewUsers: true } = 仅新用户
  audience String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders Order[]

  @@index([status, startAt, endAt])
  @@index([type])
}

/// 邀请关系 (邀请分销)。
///
/// inviteeId 唯一: 一个用户只能被一个邀请人绑定, 重复注册不覆盖 ——
/// 覆盖会让先到的邀请人丢失已发放的奖励归属, 对账无从归因。
model InviteRelation {
  id           String   @id @default(cuid())
  /// 被邀请人注册时携带的邀请码
  inviteCode   String
  inviterId    String
  /// 被邀请人。unique 保证一人只被绑定一次
  inviteeId    String   @unique
  boundAt      DateTime @default(now())
  /// 'pending' 待发放 | 'granted' 已发放 | 'rejected' 已拒绝(如自邀请)
  rewardStatus String   @default("pending")

  inviter User @relation("InviterRelations", fields: [inviterId], references: [id])
  invitee User @relation("InviteeRelation", fields: [inviteeId], references: [id])

  @@index([inviterId, rewardStatus])
  @@index([inviteCode])
  @@index([rewardStatus])
}

/// 邀请奖励规则 —— **单行配置**, 固定 id='default'。
/// 设计为单行而非多行: 奖励规则全局唯一, 多行只会带来「哪行生效」的歧义。
model InviteRewardRule {
  id             String   @id @default("default")
  /// 邀请人获得的积分数。0 = 不奖励
  inviterCredits Int      @default(0)
  /// 被邀请人获得的积分数
  inviteeCredits Int      @default(0)
  /// 触发时机: 'first_pay' 被邀请人首次付费 | 'register' 注册即发
  triggerOn      String   @default("first_pay")
  /// 关闭后新绑定不发放; **已发放的不回收**
  valid          Boolean  @default(true)
  updatedAt      DateTime @default(now())
}

/// 每日签到。
///
/// 连续天数由「该用户全部 CheckinRecord 的连续日期段」推导, 不存 streak 字段 ——
/// 存冗余streak 迟早会与记录不一致 (漏记/补记/跨时区), 而 streak 是唯一可推导值。
model CheckinRecord {
  id        String   @id @default(cuid())
  userId    String
  /// 签到日 (本地日期 YYYY-MM-DD)。与 userId 组成唯一键, 天然防重复签到
  day       String
  /// 本次实际发放积分 (含连签加成), 快照值
  credits   Int
  /// 当时的连续天数快照, 便于回溯当时的加成判定
  streak    Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// 签到规则 —— 单行配置, 固定 id='default'。
model CheckinRule {
  id          String   @id @default("default")
  /// 每日基础积分
  baseCredits Int      @default(5)
  /// 连签加成: JSON 数组, 形如 [{"day":3,"bonus":10},{"day":7,"bonus":30}]
  /// 用数组而非 map: 连续天数是无序的整数键, JSON 对象键必须是字符串
  bonusRules  String   @default("[]")
  /// 有效连签天数上限。达到后连续天数与奖励档位保持封顶，0 = 不限
  maxStreak   Int      @default(0)
  /// 周期内每日可得积分上限。0 = 不限
  dailyCap    Int      @default(0)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════════
// 账号安全域 (B2 · 2026-10-21)
// ════════════════════════════════════════════════════════════════════════════

/// 一次性账号令牌 —— 目前用于「忘记密码」重置。
///
/// 三条设计约束:
/// 1. **明文不落库**。库里只存 sha256(token), 库文件/备份泄露时拿到哈希也
///    无法反推出可用令牌; 邮件里飞的是明文, 只在发信那一刻存在于内存。
/// 2. **一次性**。`usedAt` 非空即作废, 判定与消费在同一次 updateMany 里完成,
///    避免「两个并发请求都用同一令牌改密成功」。
/// 3. **短时效**。默认 30 分钟 (见 AuthService.RESET_TOKEN_TTL_MS), 过期即拒。
model AccountToken {
  id          String    @id @default(cuid())
  /// 已注册用户发起的令牌; 注册前的手机号验证还没有 user, 故可空
  userId      String?
  /// 未注册场景(注册时的手机号验证)按手机号归属
  phone       String?
  /// 未注册场景(注册时的邮箱验证)按邮箱归属
  email       String?
  /// 'password_reset' | 'sms_login' | 'sms_verify' | 'email_verify' —— 取值由 service 常量约束
  type        String
  /// HMAC-SHA256(raw, JWT_SECRET)。6 位验证码的可枚举空间只有 100 万,
  /// 裸 sha256 在库泄露后可被离线穷举, 故用带密钥的 HMAC。
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// 校验失败次数。达到上限即作废, 防止在线穷举验证码
  attempts    Int       @default(0)
  /// 申请时的来源 IP, 仅用于安全审计与排障
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([phone, type])
  @@index([email, type])
  @@index([expiresAt])
}

/// 支付异常补偿单。每笔无法自动入账/自动退款成功的真实渠道流水都必须落单，
/// 不依赖对账明细是否被某个运行批次带出。状态机:
/// open -> auto_refund_pending -> refunded | manual_review -> closed
model PaymentExceptionCase {
  id              String    @id @default(cuid())
  /// 渠道事件指纹，回调/对账重复发现时只更新同一张单
  fingerprint     String    @unique
  providerId      String
  orderId         String?
  merchantOrderNo String
  providerTradeNo String?
  amountCents     Int
  currency        String    @default("CNY")
  kind            String
  status          String    @default("open")
  priority        String    @default("urgent")
  ownerId         String?
  slaDueAt        DateTime
  refundId        String?   @unique
  resolution      String?
  lastError       String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, priority, slaDueAt])
  @@index([providerId, merchantOrderNo])
  @@index([orderId])
}

/// 自动对账的按渠道/账单日状态。不要把「今天已触发」只放在进程内存里：
/// 进程重启或多实例部署后，失败渠道会永久漏掉重试；成功渠道也会被重复下载账单。
model PaymentAutoReconcileState {
  id                 String   @id @default(cuid())
  providerId         String
  providerInstanceId String   @default("default")
  billDate           String
  /// pending | succeeded | failed
  status             String   @default("pending")
  attempts           Int      @default(0)
  nextAttemptAt      DateTime @default(now())
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([providerId, providerInstanceId, billDate])
  @@index([status, nextAttemptAt])
}

/// 登录审计 —— 成功与失败都记。
///
/// 为什么失败也要记: 「密码错误」与「账号被禁用」在接口返回上是刻意区分的,
/// 但在审计里必须能回答「这个账号今晚被撞了多少次库」。成功记录另供后台
/// 用户详情展示「最近登录」。
model LoginLog {
  id        String   @id @default(cuid())
  /// 账号不存在时为空 (查不到 userId 也要留痕)
  userId    String?
  email     String
  ip        String?
  ua        String?
  success   Boolean  @default(true)
  /// 'password' | 'sms' 成功渠道; 'bad_credentials' | 'disabled' | 'deleted' 失败原因
  reason    String   @default("password")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

/// 扫码登录会话 (B8)。
///
/// 状态机: `pending → scanned → confirmed → consumed`, 旁路 `cancelled` / `expired`。
///
/// 为什么库里只存 `tokenHash` 而不是票据本身: 二维码会被截图、被投屏、被
/// 转发进群。票据一旦落库, 任何能读库的人 (或备份文件) 都能拿它换取会话;
/// 存哈希则泄漏者拿到的只是一串无法反推的摘要。票据本身足够随机 (256 bit),
/// 不需要加盐, 但必须一次性 —— 兑换成功即 `consumed`。
///
/// 为什么确认这一步绑在**已登录的手机**上: 桌面端拿到的会话属于「在手机上
/// 按下确认的那个人」。若攻击者把自己的票据发给你, 你确认后桌面拿到的是
/// **你的**会话 —— 这正是扫码登录的预期语义, 因此手机端必须先展示
/// 「哪台设备在请求登录」(ip / ua), 由人判断是否自己发起。
model LoginSession {
  id String @id @default(cuid())

  /// 票据明文的 SHA-256, 唯一
  tokenHash String @unique

  /// pending | scanned | confirmed | consumed | expired | cancelled
  status String @default("pending")

  /// 确认登录的账号。扫码阶段为空 —— 扫码只是「有人看到了」, 不是授权
  userId String?

  /// 发起端来源, 供手机端展示
  ip String?
  ua String?

  createdAt   DateTime  @default(now())
  /// 票据有效期。短到「截图转发也来不及用」, 长到够扫 + 确认两步
  expiresAt   DateTime
  scannedAt   DateTime?
  confirmedAt DateTime?
  consumedAt  DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([status, expiresAt])
  @@index([userId])
  @@index([expiresAt])
}

// ══════════════════════════════════════════════════════════════════════
// 财务: 发票 / 对账 (B3)
// ══════════════════════════════════════════════════════════════════════

/// 发票。
///
/// 同一订单可保留多条申请历史: 驳回后允许用户重提, 但同一时刻最多只有
/// 一张 `pending` / `issued` / `red_flushed` 票。所有历史行都保留, 便于
/// 财务追溯「哪次申请被驳回、哪次最终开具、是否已冲红」。
///
/// 金额取**开票时的可开票余额快照** (`paidCents - refundedCents`),
/// 不按当前订单金额重算: 开票之后再退款, 票面金额必须还是当时那个数。
model Invoice {
  id            String  @id @default(cuid())
  /// 发票号, 后台开具时生成 (前缀 + 日期 + 序号), 全局唯一
  invoiceNo     String  @unique
  orderId       String
  /// 有效票占用键: 有效发票等于 orderId, 驳回后置空。
  /// 数据库唯一约束兜底多实例并发申请; 历史数据该字段可能为空, 仍由状态校验兼容。
  activeOrderId String? @unique
  userId        String

  /// 开票金额 (整数分), 开具时的快照
  amountCents Int
  /// 'personal' 个人 | 'company' 企业
  kind        String  @default("personal")
  /// 发票抬头
  title       String
  /// 纳税人识别号 (企业必填, 服务层校验)
  taxNo       String?
  /// 接收邮箱 (开具后由邮件通道投递)
  email       String?
  /// 开票内容
  content     String  @default("技术服务费")

  /// 'pending' 待开具 | 'issued' 已开具 | 'rejected' 已驳回 | 'red_flushed' 已冲红
  status         String    @default("pending")
  rejectReason   String?
  /// 可打印 HTML 文件在存储后端里的 key (开具时生成)
  fileKey        String?
  issuedAt       DateTime?
  /// 开具人 (后台管理员 id)
  issuedBy       String?
  /// 冲红登记时间 / 操作人 / 原因。当前只做系统台账, 不对接税务平台
  redFlushedAt   DateTime?
  redFlushedBy   String?
  redFlushReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

/// 一次对账导入。
///
/// 对账的本质是「拿渠道账单和本地支付流水对一遍」。批次把一次导入的
/// 全部差异封在一起 —— 只存差异行、不存批次, 就无法回答「这批是谁导的、
/// 什么时候、针对哪一天」, 差异也就失去了上下文。
model ReconciliationBatch {
  id       String  @id @default(cuid())
  /// 'alipay' | 'wechat' | 'sandbox'
  channel  String
  /// 账单日期 (YYYY-MM-DD), 渠道账单针对的营业日
  billDate String
  /// 导入文件名 (仅留痕)
  fileName String?

  /// 渠道侧汇总: 文件里的总笔数与总金额 (分)
  channelCount       Int @default(0)
  channelAmountCents Int @default(0)
  /// 本地汇总: 该渠道该日已成功支付的笔数与金额 (分)
  localCount         Int @default(0)
  localAmountCents   Int @default(0)

  matchedCount Int @default(0)
  diffCount    Int @default(0)

  /// 'imported' 已导入 | 'resolved' 差异已处置完毕
  status     String  @default("imported")
  operatorId String?

  createdAt DateTime @default(now())

  items ReconciliationItem[]

  @@index([channel, billDate])
  @@index([createdAt])
}

/// 对账差异明细。
///
/// `diffType` 取值 (service 层白名单):
///   matched          金额与状态都一致
///   amount_mismatch  渠道金额 ≠ 本地金额
///   missing_local    渠道有、本地没有这笔支付 (最严重: 钱收了但订单没置 paid)
///   missing_channel  本地有、渠道账单没有 (本地记了未到账, 或渠道漏单)
///   duplicate        同一交易号在账单里出现多次
///
/// 处置**只标记不改钱** (`status`), 退款/补单仍回订单模块走各自的审计链路 ——
/// 对账工具直接改资金状态会让「谁改的、为什么」失去唯一入口。
model ReconciliationItem {
  id      String @id @default(cuid())
  batchId String
  tradeNo String

  /// 本地按 payTransactionId 命中的支付与订单
  paymentId String?
  orderId   String?

  diffType           String
  channelAmountCents Int
  localAmountCents   Int    @default(0)

  /// 'open' 待处置 | 'resolved' 已处置 | 'ignored' 已确认无需处置
  status     String    @default("open")
  note       String?
  resolvedBy String?
  resolvedAt DateTime?

  batch ReconciliationBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, tradeNo])
  @@index([diffType, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 账户自助 / 法务 / 站内消息 (B4)
// ─────────────────────────────────────────────────────────────────────────────

/// 法务文档（用户协议 / 隐私政策 / 未成年人保护）。
///
/// 版本化而不是覆盖：用户同意的是**某个版本的某一条款**，覆盖会让
/// 「他到底同意了哪一版」失去证据。发布新版本 = 新增一行 + 旧行置 archived。
model LegalDocument {
  id          String    @id @default(cuid())
  /// privacy-policy | user-agreement | minors-policy（slug 白名单在 service 层）
  slug        String
  /// 语义化版本，如 2026-10-21 或 v2
  version     String
  title       String
  /// 正文（Markdown 子集：`## 标题` 与空行分段，前端按此渲染）
  content     String
  /// 'draft' 草稿 | 'published' 已发布 | 'archived' 历史版本
  status      String    @default("draft")
  publishedAt DateTime?
  /// 发布人（后台账号 id）
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, version])
  @@index([slug, status])
}

/// 同意记录 —— 注册 / 下单时勾选的那一份条款。
///
/// 只记「谁同意了哪个 slug 的哪个 version」，不存正文快照：
/// 正文在 LegalDocument 里按 (slug, version) 唯一，重复存储只会让两份数据打架。
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String?
  /// register | order | legal_update
  kind      String
  slug      String
  version   String
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, kind])
  @@index([slug, version])
}

/// 站内消息。
///
/// 与邮件/短信是**并行的通道**，不是替代：邮件会丢在垃圾箱、短信有成本，
/// 「支付成功」「任务失败已退款」这类与钱相关的通知必须在站内也能查到。
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// payment_success | credit_granted | task_failed | membership_expired | ticket_reply | broadcast
  type      String
  title     String
  body      String?
  /// 站内相对路径，如 /orders
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 消息模板（后台可改的文案）。
///
/// 代码里按 `code` 取模板并做变量替换，取不到即用代码内置兜底文案 ——
/// 「模板表为空」不能让支付成功的通知消失。
model MessageTemplate {
  id        String   @id @default(cuid())
  /// 唯一编码，如 payment_success / task_failed_refund
  code      String   @unique
  /// inapp | email | sms
  channel   String
  subject   String?
  /// 支持 {orderNo} 这类占位符，白名单变量
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([channel, enabled])
}

/// 能力上下线管控（后台可关停单项能力）。
///
/// 为什么不复用 `SystemSetting`：能力的开关是**每项一行**的结构化状态，
/// 存成 JSON 会让「当前哪些能力被下线、因为什么、谁改的」在数据库里不可查询，
/// 排障时只能捞一整条大 JSON 比对。单独建表也让审计与唯一约束落在能力 id 上。
///
/// 语义：**没有行 = 启用**（默认全开），只有显式关停才落行。这样新增能力
/// 无需先插一行，也不会因为漏插而「新能力默认不可用」。
model CapabilityControl {
  capabilityId String   @id
  enabled      Boolean  @default(true)
  /// 对用户展示的原因（关停时必填）
  reason       String?
  /// 操作人（管理员 id / 邮箱），审计日志另有完整一份
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([enabled])
}

// ═══════════════════════════════════════════════════════════════════════
// 工单与反馈 (B7)
// ═══════════════════════════════════════════════════════════════════════

/// 用户工单 / 反馈。
///
/// 为什么单独建表而不是复用站内消息: 消息是**单向广播** (平台 → 用户),
/// 工单是**双向会话 + 有状态流转 + 有归属**。塞进 Notification 会同时失去
/// 「谁在处理」「处理到哪一步」「用户回了什么」三件事, 而这三件事才是
/// 客服排障的全部依据。
///
/// `orderId` / `assetId` 只存字符串不建外键: 素材可能被删, 而工单是用户
/// 举证过的记录 —— 建级联外键会让「素材被删」把工单一起带走。订单本就不
/// 物理删除, 但同理不引外键, 避免删除顺序耦合。
model Ticket {
  id         String    @id @default(cuid())
  /// 对用户可见的工单号，形如 T20261021A1B2C3
  ticketNo   String    @unique
  userId     String
  /// bug | complaint | consultation | invoice | other
  type       String
  subject    String
  content    String
  /// 流转: open → processing → resolved → closed
  /// SQLite 无 enum, 取值由 service 的状态机约束 (见 ticket.service.ts)
  status     String    @default("open")
  /// low | normal | high
  priority   String    @default("normal")
  /// 关联订单 / 素材（可空）。只存 id 不建外键，理由见模型注释
  orderId    String?
  assetId    String?
  /// 指派的后台账号 id（null = 未指派，谁先处理谁认领）
  assigneeId String?
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([assigneeId])
  @@index([type, createdAt])
}

/// 工单回复。用户与客服共用一张表，靠 authorType 区分 ——
/// 分成两张表会让「按时间顺序拼出会话」变成一次内存归并，而且
/// 分页时两条流的时间线无法对齐。
model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  /// user | admin
  authorType String
  authorId   String
  /// 冗余当时的展示名：用户改昵称后，历史工单里客服看到的名字应保持原样
  authorName String
  content    String
  /// public | internal。internal 只给后台看，不推送、不下发 C 端，
  /// 用于工单转交财务时的交接备注。
  visibility String   @default("public")
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ── AIGC 可见标识样式 (2026-10-21) ──────────────────────────────────
// 单行结构化文档 (id 恒为 'default'), 不走 SystemSetting 的 kv 形状:
// 一个角标由「文案 + 字体 + 配色 + 几何 + 一张预渲染位图」共同决定,
// 拆成十几个 kv 行只会让「哪一组值属于同一次保存」无法保证。
//
// ## 为什么存的是渲染好的 PNG, 而不是运行时按 spec 画字
//
// 中文无法在服务端零依赖地栅格化: Jimp 内置字体只有 ASCII, 引字体引擎
// 又会破坏「精确锁定 + 手工直装」的依赖纪律。因此**文字由后台页面用
// 浏览器 Canvas 渲染成 PNG**, 服务端只负责缩放、定位与合成。
// 好处是字体/字重/字距/颜色/中文全部可配且所见即所得; 代价是改文案或
// 字体后必须从后台页面再保存一次 (specKey 用来标记位图是否已过期)。
model AigcLabelConfig {
  id        String   @id @default("default")
  /// 结构化样式 JSON (AigcLabelSpec)。见 src/common/aigc-label.config.ts
  specJson  String
  /// 渲染相关字段的指纹。与当前 spec 不一致 = 位图过期 (后台页面会提示)
  specKey   String
  /// 浏览器按 spec 渲染的角标 PNG (base64, 无 data: 前缀); null = 用内置默认角标
  pngBase64 String?
  pngWidth  Int?
  pngHeight Int?
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════════
// 渠道与模型子系统（移植自 open-ai-canvas，2026-10-31）
//
// 层次：渠道 ModelChannel → 渠道模型 ChannelModel → 价格档 ChannelModelPriceTier
//      → 前台模型 LogicalModel / Revision / Route → 任务快照 RouteAttempt
//
// 约定（与全仓一致）：
//   · 无 enum，状态类字段一律 String，取值由 DTO/service 白名单约束；
//   · JSON 列以 String 存储，读写走 `src/model/domain/codec.ts` 的类型化编解码；
//   · 金额一律 BigInt 微积分（1 积分 = 1,000,000 微积分），出接口前做安全整数校验；
//   · 软删除统一 `deletedAt`，存活期的业务唯一性靠 `activeKey`（存活时等于业务键，
//     删除时置 null）—— SQLite 没有「WHERE deleted_at IS NULL」的部分唯一索引；
//   · 除既有表外，本域不建 Prisma 关系：历史账单/日志要能在主体删除后独立可读。
// ════════════════════════════════════════════════════════════════════════════

/// 系统渠道（后台配置的上游连接）。凭证只存密文（`enc:v1:` 前缀），永不回显。
model ModelChannel {
  id     String @id @default(cuid())
  /// 归属用户；系统渠道为空串（保留字段以对齐参考实现的自建渠道）
  userId String @default("")
  /// 'system' 系统渠道 | 'user' 用户自建渠道
  scope  String @default("system")

  enabled   Boolean @default(true)
  name      String
  /// 渠道排序：数字越小越靠前
  sortOrder Int     @default(0)

  baseUrl          String @default("")
  /// 密文；空串 = 未配置
  apiKey           String @default("")
  /// 密文；即梦等需要 AK/SK 双凭证的渠道使用
  secretKey        String @default("")
  /// 请求格式（系统渠道固定 openai，实际协议由所选模型决定）
  apiFormat        String @default("openai")
  /// 0 = 使用全局并发上限
  concurrencyLimit Int    @default(0)
  /// 渠道级出站代理：socks5:// / socks5h:// / http:// / https://；空 = 全局代理
  proxyUrl         String @default("")

  /// 上游模型名清单（JSON 字符串数组），用于初始化渠道模型
  modelsJson        String @default("[]")
  /// 已被模型家族吸收的上游 SKU（JSON 字符串数组），目录拉取时不再重复建行
  retiredModelsJson String @default("[]")
  /// 自定义请求头（密文 JSON，可能含鉴权值）
  headersJson       String @default("")
  /// 由哪个服务商目录一键接入；空 = 自定义渠道。仅用于来源展示
  catalogProviderId String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// 软删除；凭证在删除时清空
  deletedAt DateTime?

  @@index([scope, enabled])
  @@index([deletedAt])
  @@index([catalogProviderId])
  @@index([sortOrder])
}

/// 渠道模型：渠道内的一个可执行上游 SKU。
/// `modelKey` 是本站对外的模型标识，`providerModelKey` 是发给上游的键。
model ChannelModel {
  id        String  @id @default(cuid())
  channelId String
  modelKey  String
  /// 存活时 = modelKey（小写）；删除时置 null，以 `[channelId, activeKey]` 唯一
  activeKey String?

  providerModelKey String @default("")
  displayName      String @default("")
  channelLabel     String @default("")
  /// 标签 JSON：[{ text, color }]，最多 5 个
  tags             String @default("[]")
  description      String @default("")
  sortOrder        Int    @default(0)
  icon             String @default("")

  /// 'text' | 'image' | 'video' | 'audio'
  capability String
  /// 协议 id（ProtocolRegistry 唯一事实源）
  protocol   String

  /// 'fixed_request' | 'per_second' | 'token'；标量价只是历史兼容与摘要
  billingMode                  String  @default("fixed_request")
  unitPriceMicrocredits        BigInt  @default(0)
  inputTokenPriceMicrocredits  BigInt  @default(0)
  outputTokenPriceMicrocredits BigInt  @default(0)
  cachedTokenPriceMicrocredits BigInt  @default(0)
  /// 是否存在至少一个启用且已配置价格的有效档位
  priceConfigured              Boolean @default(false)
  enabled                      Boolean @default(true)
  /// 价格变更计数，批量调价用它做乐观并发校验
  priceVersion                 Int     @default(0)

  /// 'credits' | 'USD' | 'CNY'：价格档售价的单位
  priceCurrency String @default("credits")

  /// 模型能力合同（JSON），价格档选择器与运行期参数校验都读它
  capabilityConfigJson String @default("")
  capabilityVersion    Int    @default(0)
  /// 来自服务商目录的推荐模型 key（排查来源用）
  catalogModelKey      String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([channelId, activeKey])
  @@index([channelId, enabled])
  @@index([capability, protocol])
  @@index([deletedAt])
}

/// 价格档：渠道模型在一个规格组合下的上游 SKU 与售价。
/// `selectorKey` 是规范化 JSON（如 {"operation":"text_to_image","quality":"2k"}），
/// 是规格唯一性与匹配的唯一依据。
model ChannelModelPriceTier {
  id             String  @id @default(cuid())
  channelModelId String
  /// 存活时 = selectorKey；删除时置 null
  activeKey      String?

  selectorKey  String @default("{}")
  /// 原始选择器 JSON（与 selectorKey 同内容，保留便于排查历史写法）
  selectorJson String @default("{}")
  /// 冗余：视频分辨率档位（'*' = 任意），仅用于展示与历史兼容
  resolution   String @default("*")
  videoSeconds Int    @default(0)

  providerModelKey String @default("")
  billingMode      String @default("fixed_request")

  // ── 成本价（仅后台可见，不叠倍率、不参与售价）────────────────────
  costConfigured                   Boolean @default(false)
  costUnitPriceMicrocredits        BigInt  @default(0)
  costInputTokenPriceMicrocredits  BigInt  @default(0)
  costOutputTokenPriceMicrocredits BigInt  @default(0)
  costCachedTokenPriceMicrocredits BigInt  @default(0)

  // ── 售价 ──────────────────────────────────────────────────────────
  unitPriceMicrocredits        BigInt  @default(0)
  inputTokenPriceMicrocredits  BigInt  @default(0)
  outputTokenPriceMicrocredits BigInt  @default(0)
  cachedTokenPriceMicrocredits BigInt  @default(0)
  priceConfigured              Boolean @default(false)
  enabled                      Boolean @default(true)
  priceVersion                 Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([channelModelId, activeKey])
  @@index([channelModelId, enabled])
  @@index([deletedAt])
}

/// 前台模型：C 端可售卖的 SKU。价格策略 `pricePolicy=unified` 用标量价，
/// `channel` 跟随所选渠道模型的价格档（此时标量价只读）。
model LogicalModel {
  id          String  @id @default(cuid())
  code        String
  /// 存活且未归档时 = code 小写；归档/删除时置 null
  activeKey   String?
  name        String
  icon        String  @default("")
  description String  @default("")
  capability  String
  enabled     Boolean @default(true)
  sortOrder   Int     @default(0)

  /// 已分配的 revision 版本号，由数据库原子递增（update increment）
  revisionSequence     Int    @default(0)
  activeRevisionId     String @default("")
  /// 由哪个渠道模型投影而来（仅用于来源展示与重建）
  sourceChannelModelId String @default("")

  /// 'unified' 统一价 | 'channel' 跟随渠道价格档
  pricePolicy             String @default("unified")
  billingMode             String @default("fixed_request")
  unitPriceMicrocredits   BigInt @default(0)
  inputPriceMicrocredits  BigInt @default(0)
  outputPriceMicrocredits BigInt @default(0)
  cachedPriceMicrocredits BigInt @default(0)
  /// 旧 SKU 选择的无缝映射（JSON 字符串数组）
  legacyModelIdsJson      String @default("[]")

  /// 归档后仅从可选目录隐藏；历史任务与审计仍可读取
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([activeKey])
  @@index([capability, enabled])
  @@index([sortOrder])
  @@index([archivedAt])
  /// 目录加载按生效 revision 反查线路；没有索引会退化成全表扫
  @@index([activeRevisionId])
  /// 一个渠道模型最多投影出一个未归档前台模型（应用层另有校验）
  @@index([sourceChannelModelId])
}

/// 前台模型 revision：一次发布的能力合同与默认参数，创建后不可变。
model LogicalModelRevision {
  id                 String   @id @default(cuid())
  logicalModelId     String
  version            Int
  /// 能力合同 JSON（CapabilitySpec）
  capabilitySpecJson String   @default("{}")
  /// 默认参数 JSON
  defaultOptionsJson String   @default("{}")
  createdBy          String   @default("")
  createdAt          DateTime @default(now())

  @@unique([logicalModelId, version])
  @@index([logicalModelId])
}

/// 路线：前台模型 revision 可用的渠道模型，`priority` 硬分层、同层按 `weight` 加权。
model LogicalModelRoute {
  id                     String   @id @default(cuid())
  logicalModelRevisionId String
  channelModelId         String
  enabled                Boolean  @default(true)
  priority               Int      @default(0)
  weight                 Int      @default(100)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([logicalModelRevisionId, channelModelId])
  @@index([enabled, priority])
  @@index([channelModelId])
}

/// 路由尝试：一次任务在一条线路上的派发记录。`dispatchState` 决定能否安全切换。
model RouteAttempt {
  id            String @id @default(cuid())
  taskId        String
  /// 用户手动重试时 +1；故障切换不改
  routeRun      Int
  attemptNumber Int

  logicalModelId         String @default("")
  logicalModelRevisionId String @default("")
  routeId                String @default("")
  channelModelId         String @default("")
  channelId              String @default("")

  /// 'selected' | 'dispatching' | 'succeeded' | 'failed'
  status            String @default("selected")
  /// 'not_sent' | 'submission_unknown' | 'accepted' | 'rejected_no_job'
  dispatchState     String @default("not_sent")
  providerRequestId String @default("")
  failureCode       String @default("")
  failureMessage    String @default("")

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([taskId, routeRun, attemptNumber])
  @@index([taskId])
  @@index([channelModelId])
  @@index([status])
  /// 按本轮尝试集合重建候选池
  @@index([routeRun])
  /// 扫描「上游是否已接单」的待恢复任务
  @@index([dispatchState])
  /// 按上游请求号反查尝试记录
  @@index([providerRequestId])
}

/// 用户分组：统一倍率、货币兑换比例与可见渠道。
/// `ratioBasisPoints` 10000 = 1.0；`pointsPerUsd/Cny` 以微积分表示 1 货币单位兑换的积分。
model UserGroup {
  id        String  @id @default(cuid())
  code      String
  /// 存活时 = code 小写；删除时置 null
  activeKey String?

  name        String @default("")
  description String @default("")
  badgeLabel  String @default("")
  /// 'none' | 'vip' | 'svip'
  badgeStyle  String @default("none")
  sortOrder   Int    @default(0)

  ratioBasisPoints   Int     @default(10000)
  pointsPerUsd       BigInt  @default(0)
  pointsPerCny       BigInt  @default(0)
  /// true = 可使用全部系统渠道，不读 UserGroupChannel
  /// 可见全部系统渠道。默认 false —— 管理员新建分组时若漏传该字段，
  /// 不应默认获得全部渠道可见性（参考实现同样是 false；
  /// 默认分组由 `UserGroupService.ensureDefaultGroup` 显式置 true）。
  allChannels        Boolean @default(false)
  /// 模型级覆盖 JSON：[{ modelKey, ratioBasisPoints, pointsPerUsd, pointsPerCny }]
  modelOverridesJson String  @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([activeKey])
  @@index([sortOrder])
  @@index([deletedAt])
}

/// 分组 → 可见系统渠道（AllChannels=false 时生效）
model UserGroupChannel {
  groupId   String
  channelId String
  createdAt DateTime @default(now())

  @@id([groupId, channelId])
  @@index([channelId])
}

/// 生成账单：一次生成任务的扣费快照与状态机（reserved → running → settled/refunded/uncertain）。
/// 与充值订单 `Order` 完全分离：本表只记「生成消耗」。
model BillingOrder {
  id             String @id @default(cuid())
  userId         String
  /// 幂等键：与 userId 组成唯一约束
  idempotencyKey String

  taskId            String @default("")
  channelId         String @default("")
  channelModelId    String @default("")
  priceTierId       String @default("")
  priceTierVersion  Int    @default(0)
  priceSelectorJson String @default("{}")

  /// 下单时改写为前台模型 code（渠道策略下供应线路留在 channel* 字段）
  model        String @default("")
  capability   String @default("")
  scene        String @default("")
  billingMode  String @default("fixed_request")
  priceVersion Int    @default(0)

  unitPriceMicrocredits    BigInt @default(0)
  multiplierBasisPoints    BigInt @default(10000)
  /// 下单时的分组与货币快照
  userGroup                String @default("")
  priceCurrency            String @default("")
  currencyRateMicrocredits BigInt @default(0)

  quantity                   BigInt  @default(1)
  amountMicrocredits         BigInt  @default(0)
  reservedAmountMicrocredits BigInt  @default(0)
  /// true 表示显式授权上限（含授权为 0 的免费单）
  chargeLimitSet             Boolean @default(false)
  chargeLimitMicrocredits    BigInt  @default(0)
  actualAmountMicrocredits   BigInt  @default(0)
  refundedAmountMicrocredits BigInt  @default(0)

  inputTokenPriceMicrocredits  BigInt  @default(0)
  outputTokenPriceMicrocredits BigInt  @default(0)
  cachedTokenPriceMicrocredits BigInt  @default(0)
  inputTokens                  BigInt  @default(0)
  outputTokens                 BigInt  @default(0)
  cachedTokens                 BigInt  @default(0)
  /// 视频公式用量（tokens），不含预授权余量
  videoFormulaTokens           BigInt  @default(0)
  /// 'provider'（上游 usage）| 'video_formula'（提交时公式快照）| ''
  usageSource                  String  @default("")
  usageAvailable               Boolean @default(false)

  // ── 成本快照（仅后台可见）─────────────────────────────────────────
  costConfigured                   Boolean @default(false)
  costUnitPriceMicrocredits        BigInt  @default(0)
  costInputTokenPriceMicrocredits  BigInt  @default(0)
  costOutputTokenPriceMicrocredits BigInt  @default(0)
  costCachedTokenPriceMicrocredits BigInt  @default(0)
  costBillingMode                  String  @default("")
  costQuantity                     BigInt  @default(0)
  costVideoFormulaTokens           BigInt  @default(0)

  /// 'reserved' | 'running' | 'settled' | 'refunded' | 'uncertain'
  status            String @default("reserved")
  providerRequestId String @default("")
  promotionId       String @default("")
  errorText         String @default("")
  resolvedBy        String @default("")
  resolutionNote    String @default("")
  /// 批量人工核对批次号。同一次批量操作写入同一个值，便于财务追溯
  reviewBatchId     String @default("")

  startedAt    DateTime?
  settledAt    DateTime?
  refundedAt   DateTime?
  /// 退款原因分类。决定这笔退款算「用户拿回钱」还是「平台内部换线路重预留」。
  ///
  /// `route_switch` = 线路切换：钱没有离开平台，只是从旧线路的预授权挪到新线路的
  /// 预授权。若把它算进「已退」，一次 9 分换 4 分的成功任务会显示净收入 −5 ——
  /// 明明收了 4 分。财务口径必须把它排除在「已退」之外。
  ///
  /// 其余取值：`failure`（任务失败/取消退款）、`manual`（人工核对退款）、
  /// `proxy_timeout`（中转超时退款）、`auto_sweep`（预留超时自动退款）、
  /// 空串 = 未分类（按真实退款计入「已退」）。
  refundReason String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([taskId])
  @@index([channelId])
  @@index([channelModelId])
  @@index([status, createdAt])
  @@index([reviewBatchId])
  /// 财务分析按模型 / 能力 / 场景三维分组聚合
  @@index([model])
  @@index([capability])
  @@index([scene])
}

/// 积分账户：可用 / 预留余额的权威（批次 `CreditLot` 为批次维度权威）。
model CreditAccount {
  userId                String   @id
  availableMicrocredits BigInt   @default(0)
  reservedMicrocredits  BigInt   @default(0)
  /// 乐观并发版本号
  version               Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// 微积分流水 —— 只追加。每条都记 available / reserved 的变动与变动后快照。
model CreditLedgerEntry {
  id     String @id @default(cuid())
  userId String
  /// 'grant' | 'purchase' | 'admin_adjust' | 'refund_reclaim' | 'reserve' | 'consume' | 'refund' | 'expire'
  type   String

  amountMicrocredits         BigInt
  availableDeltaMicrocredits BigInt @default(0)
  reservedDeltaMicrocredits  BigInt @default(0)
  availableAfterMicrocredits BigInt
  reservedAfterMicrocredits  BigInt

  billingOrderId String  @default("")
  paymentOrderId String  @default("")
  /// 关联批次（grant / expire 这类只作用于单一批次的流水会写入，便于回查「这笔积分原本多少、何时过期」）
  lotId          String  @default("")
  /// 生成任务 id（区别于充值订单；后台流水按任务排查时用）
  taskId         String  @default("")
  actorUserId    String  @default("")
  model          String  @default("")
  channelId      String  @default("")
  scene          String  @default("")
  note           String  @default("")
  /// 幂等键（同一业务动作重复执行只落一条）
  referenceKey   String? @unique

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([billingOrderId])
  @@index([lotId])
}

/// 预留明细：某个账单从哪些批次扣了多少微积分（结算/退款按此回填）。
model CreditReservationItem {
  billingOrderId String
  /// 对应 `CreditLot.id`
  lotId          String
  microcredits   BigInt

  @@id([billingOrderId, lotId])
  @@index([lotId])
}

/// 上游调用记录 —— 只允许 INSERT。
/// 请求/响应体在写入前截断并脱敏，密钥永不落库。
model ApiCallLog {
  id        String @id @default(cuid())
  userId    String @default("")
  traceId   String @default("")
  requestId String @default("")

  channelId      String @default("")
  channelName    String @default("")
  /// 渠道模型 id：线路级健康指标（成功率 / P95）的归属键。
  /// 空串 = 该次调用没有落到具体渠道模型（如渠道级 `GET /models`）。
  channelModelId String @default("")
  taskId         String @default("")
  billingOrderId String @default("")

  source      String  @default("")
  capability  String  @default("")
  operation   String  @default("")
  /// 'proxy' | 'task'
  requestKind String  @default("")
  billable    Boolean @default(false)
  apiFormat   String  @default("")
  method      String  @default("")
  path        String  @default("")
  model       String  @default("")

  /// 'success' | 'failed' | 'pending' | 'canceled'
  status            String  @default("")
  statusCode        Int     @default(0)
  durationMs        Int     @default(0)
  pollCount         Int     @default(0)
  providerStatus    String  @default("")
  inputTokens       BigInt  @default(0)
  outputTokens      BigInt  @default(0)
  cachedTokens      BigInt  @default(0)
  usageAvailable    Boolean @default(false)
  mediaCount        Int     @default(0)
  videoSeconds      Int     @default(0)
  providerRequestId String  @default("")

  /**
   * 上游美元成本估算三列：**已废弃，恒为默认值**。
   * 参考实现有一张独立的「模型定价」表（`ModelPricing`，美元口径）来估算
   * 每次调用的上游成本。本仓的成本来源是**渠道模型价格档的成本价**（微积分口径），
   * 建单时随账单快照（见 `BillingOrder.cost*`），口径唯一且是真实值。
   * 这三列在全仓没有任何写入点，长期恒为 0 / false / ''。保留列是为了不做
   * 破坏性迁移（drop column 会丢历史数据）；但**接口层已不再下发它们**，
   * 以免日志页出现「有这一列却恒为空」的误导。
   * 若将来要恢复美元口径的上游成本估算，应新增独立定价表 + 写入点，
   * 而不是复活这三列。
   */
  estimatedCostMicros BigInt  @default(0)
  costAvailable       Boolean @default(false)
  currency            String  @default("")

  errorCode          String @default("")
  error              String @default("")
  concurrencyLimit   Int    @default(0)
  upstreamUrl        String @default("")
  requestContentType String @default("")
  requestBody        String @default("")
  responseBody       String @default("")

  startedAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([channelId, createdAt])
  @@index([channelModelId, createdAt])
  @@index([model, createdAt])
  @@index([taskId])
  @@index([status, createdAt])
  @@index([createdAt])
  /// 可用率统计按「请求类型 + 状态 + 时间窗」过滤
  @@index([requestKind, status, createdAt])
}

/// 系统级插件可用性（管理员启停内置/上传插件）。
model PluginPlatformState {
  pluginId   String   @id
  /// 'builtin' | 'uploaded'
  source     String   @default("builtin")
  enabled    Boolean  @default(true)
  /// 最近一次校验结果（JSON）：{ ok, checkedAt, reason }
  verifyJson String   @default("{}")
  updatedBy  String   @default("")
  updatedAt  DateTime @updatedAt
}

/// 单用户插件启用状态（用户自建渠道可选协议范围）
model UserPluginState {
  userId   String
  pluginId String
  enabled  Boolean @default(true)

  @@id([userId, pluginId])
}

/// 路由目录版本：后台写入后递增，多进程按版本号判断是否需要重载快照。
model RouteCatalogVersion {
  id        String   @id @default("catalog")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 支付渠道配置。**追加写、不原地修改**。
/// 订单与 Payment 固定 providerConfigId/version，历史订单回调验签必须还能取到当时的密钥。
model PaymentProviderConfig {
  id                String   @id @default(cuid())
  /// 适配器 id：sandbox | alipay | wechat | epay ...
  providerId        String
  /// 同一渠道下稳定的实例标识；服务端生成，不作为凭据
  instanceId        String   @default("default")
  /// 后台展示名；空时使用渠道名 + 实例序号
  name              String?
  /// 实例在渠道内的展示/选择顺序
  sortOrder         Int      @default(0)
  /// 实例内单调递增版本，从 1 开始
  version           Int
  enabled           Boolean  @default(false)
  closeAfterMinutes Int      @default(30)
  /// 实例级限额（分）；null 表示不限制
  minAmountCents    Int?
  maxAmountCents    Int?
  dailyLimitCents   Int?
  /// 是否允许对该实例产生的支付发起退款
  refundEnabled     Boolean  @default(true)
  /// 实例支持的 C 端支付方式子集，JSON 数组字符串
  paymentMethods    String   @default("[\"alipay\",\"wechat\"]")
  /// AES-256-GCM 密文；明文是 Record<string,string> 的 JSON，含密钥
  configCipher      String   @default("")
  /// 配置的规范化摘要（sha256），用于识别「无改动保存」
  configDigest      String   @default("")
  /// 管理员 id；首次 env 引导为 'bootstrap'
  createdBy         String?
  createdAt         DateTime @default(now())

  @@unique([providerId, instanceId, version])
  @@index([providerId, instanceId, sortOrder])
  @@index([providerId, createdAt])
}

/// 持久化轮询游标；多进程部署也不能只放内存。
model PaymentRoundRobinCursor {
  providerId String
  method     String
  cursor     Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([providerId, method])
}

/// 渠道异步通知收件箱。验签通过后、入账前落库，保证进程重启不丢通知。
model PaymentNotification {
  id               String    @id @default(cuid())
  providerId       String
  /// 渠道事件 id；渠道不提供时用 sha256(providerId + ':' + rawBody)
  providerEventId  String
  /// 回调 URL 固定下来的配置版本
  providerConfigId String
  merchantOrderNo  String
  orderId          String?
  /// sha256(rawBody)，用于排障与日志关联，不落明文
  payloadDigest    String
  /// 验签通过的原始报文 AES-256-GCM 密文
  payloadCipher    String    @default("")
  /// 适配器归一化后的业务字段 JSON；不得含密钥，可含渠道交易字段
  normalizedJson   String    @default("{}")
  /// pending | processing | processed | failed
  status           String    @default("pending")
  attempts         Int       @default(0)
  lastError        String?
  nextAttemptAt    DateTime  @default(now())
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([providerId, providerEventId])
  @@index([status, nextAttemptAt])
  @@index([merchantOrderNo])
  @@index([orderId])
}

/// 单次对账运行。失败可在同一账单日重跑，attempt 递增，历史运行不覆盖。
model PaymentReconciliationRun {
  id                 String    @id @default(cuid())
  providerId         String
  providerInstanceId String    @default("default")
  /// 运行时使用的配置版本；证据链不依赖「当前最新版」
  configId           String?
  billDate           String
  /// 同一渠道同一账单日的第几次运行，从 1 开始
  attempt            Int       @default(1)
  /// provider（渠道自动下载）| csv（人工上传兜底）
  source             String    @default("provider")
  fileName           String?
  /// running | completed | failed
  status             String    @default("running")
  totalItems         Int       @default(0)
  matchItems         Int       @default(0)
  recoveredItems     Int       @default(0)
  errorItems         Int       @default(0)
  error              String?
  startedBy          String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items PaymentReconciliationItem[]

  @@unique([providerId, providerInstanceId, billDate, attempt])
  @@index([providerId, providerInstanceId, billDate, status])
  @@index([status, createdAt])
}

model PaymentReconciliationItem {
  id              String   @id @default(cuid())
  runId           String
  providerId      String
  orderId         String?
  merchantOrderNo String
  providerTradeNo String?
  amountCents     Int
  currency        String   @default("CNY")
  /// matched | recovered | local_order_not_found | provider_record_missing
  /// | amount_mismatch | trade_no_mismatch | duplicate_charge | credit_failed
  result          String
  /// 该差异是否已由本次运行自动处理；不表示人工结案
  resolved        Boolean  @default(false)
  detail          String?
  createdAt       DateTime @default(now())

  run PaymentReconciliationRun @relation(fields: [runId], references: [id])

  /// 同一商户订单号可能对应多条渠道流水（例如重复扣款）。
  /// 对账明细必须保留每次渠道交易，不能用商户订单号互相覆盖。
  @@unique([runId, merchantOrderNo, providerTradeNo])
  @@index([result])
  @@index([providerId, merchantOrderNo])
}
