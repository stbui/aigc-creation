# ─────────────────────────────────────────────────────────────────────────────
# 前端开发环境（vite --mode development）
#
# 本文件**入库**，只放非敏感配置。
# 个人覆盖写 .env.development.local（gitignore），优先级更高。
#
# Vite 的 mode 与后端的 NODE_ENV 是两套东西：这里靠 --mode 显式对齐，
# 见 package.json 的 dev / build:dev / build:prod 脚本。
# ─────────────────────────────────────────────────────────────────────────────

# 访问后端的基址。
# 开发态走 vite proxy（见 vite.config.ts），因此留空即可 —— 同源代理
# 不触发 CORS，换端口时也不必改前端代码。
VITE_API_BASE=

# vite dev server 端口（start.sh 未显式指定时用这个值）
# 刻意避开 5173 这类常被其它前端项目占用的端口
VITE_PORT=5100

# vite dev server 把 /api 代理到哪个后端。
# 改这个值就够，不必动 VITE_API_BASE。
VITE_API_PROXY=http://localhost:4100

# 环境标识：显示在后台右上角（非生产环境才显示）
VITE_ENV_LABEL=开发