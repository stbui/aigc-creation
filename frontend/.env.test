# ─────────────────────────────────────────────────────────────────────────────
# 前端测试环境（vite --mode test）
#
# 端口与开发档**相同**（5100）：两档不能同时跑，起测试档会停掉开发档。
# 与开发环境的隔离靠的是后端库/目录/密钥，不是端口。
# 后端对应档位见 backend/.env.test（独立库 test.db + 独立 JWT 密钥）。
#
# ⚠ 走 vite proxy（同源 /api），所以 VITE_API_BASE 留空即可。
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_BASE=

VITE_PORT=5100

# 指向测试环境后端（backend/.env.test 的 PORT=4100）
VITE_API_PROXY=http://localhost:4100

VITE_ENV_LABEL=测试
