# ─────────────────────────────────────────────────────────────────────────────
# 前端测试环境（vite --mode test）
#
# 与开发环境分开端口，避免两个 dev server 互抢 5100。
# 规律：开发 4100/5100 → 测试 4200/5200。
# 后端对应档位见 backend/.env.test（独立库 test.db + 独立 JWT 密钥）。
#
# ⚠ 走 vite proxy（同源 /api），所以 VITE_API_BASE 留空即可。
#   对应后端的 CORS_ORIGINS 已显式放行 5200（见 backend/.env.test）。
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_BASE=

VITE_PORT=5200

# 指向测试环境后端（backend/.env.test 的 PORT=4200）
VITE_API_PROXY=http://localhost:4200

VITE_ENV_LABEL=测试