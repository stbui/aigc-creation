# ─────────────────────────────────────────────────────────────────────────────
# 前端测试环境（vite --mode test）
#
# 与开发环境分开端口，避免两个 dev server 互抢5173。
# 后端对应档位见 backend/.env.test（独立库 test.db + 独立 JWT 密钥）。
#
# ⚠ 走 vite proxy（同源 /api），所以 VITE_API_BASE 留空即可。
#   对应后端的 CORS_ORIGINS 已显式放行 5273（见 backend/.env.test）。
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_BASE=

VITE_PORT=5273

# 指向测试环境后端（backend/.env.test 的 PORT=3101）
VITE_API_PROXY=http://localhost:3101

VITE_ENV_LABEL=测试